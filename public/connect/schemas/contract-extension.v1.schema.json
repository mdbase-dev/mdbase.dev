{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mdbase.dev/connect/schemas/contract-extension.v1.json",
  "title": "mdbase connect contract extension",
  "description": "Common envelope for an x-* type-file extension exposed as an application contract.",
  "type": "object",
  "required": ["contract", "version"],
  "properties": {
    "contract": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "version": { "type": "integer", "minimum": 1 }
  }
}
