---
import DocsLayout from "../../../components/DocsLayout.astro";
import CodeBlock from "../../../components/CodeBlock.astro";

import app from "../../../../examples/worklog/src/App.tsx?raw";

const install = `npm install --save-exact @mdbase-dev/ui @mdbase-dev/i18n \\
  @lingui/core@6.9.0 @lingui/react@6.9.0`;

const css = `import "@mdbase-dev/ui/collections.css";`;

const gateProps = `<CollectionGate
  mdbase={mdbase}
  app={{ name: "Worklog", mark: <WorklogIcon /> }}
  layout="panel"
  extraActions={<a href="/about">What is Worklog?</a>}
  onBeforeLeave={(intent) => (hasUnsavedDraft() ? confirmLeave(intent) : true)}
  unsynced
>
  {(connection) => <Worklog db={connection.records} />}
</CollectionGate>`;

const switcher = `// In a header: the collection's name, opening the list.
<CollectionSwitcher mdbase={mdbase} app={app} variant="compact" />

// In a toolbar: a button with an icon only.
<CollectionSwitcher mdbase={mdbase} app={app} variant="icon" />

// Opened from an item in your own menu.
const [open, setOpen] = useState(false);
const menuButton = useRef<HTMLButtonElement>(null);

<CollectionSwitcher
  mdbase={mdbase}
  app={app}
  variant="none"
  open={open}
  onOpenChange={setOpen}
  anchorRef={menuButton}
/>`;

const problem = `import { CollectionProblem } from "@mdbase-dev/ui/collections";

// The current phase's problem, as a banner above your content:
<CollectionProblem mdbase={mdbase} app={app} variant="banner" />

// An error from one of your own calls:
<CollectionProblem mdbase={mdbase} app={app} problem={error} />`;

const theme = `.worklog {
  --mdbase-collections-accent: #0f766e;
  --mdbase-collections-on-accent: #ffffff;
  --mdbase-collections-font: "Inter", system-ui, sans-serif;
  --mdbase-collections-radius: 6px;
}`;

const mount = `import { mountCollectionUi } from "@mdbase-dev/ui/collections";
import "@mdbase-dev/ui/collections.css";
import { mdbase } from "./mdbase";

const app = { name: "Worklog" };

// Sign-in, choosing and the list, inside your own dialog or page.
const panel = mountCollectionUi(document.querySelector("#collections"), {
  part: "panel",
  mdbase,
  app,
});

// The header control.
mountCollectionUi(document.querySelector("#switcher"), {
  part: "switcher",
  variant: "compact",
  mdbase,
  app,
});

mdbase.subscribe(() => {
  const { phase } = mdbase.getSnapshot();
  const open = phase.kind === "ready" || phase.kind === "unsynced";
  document.querySelector("#collections").hidden = open;
  if (open) showWorklog(phase.connection.records);
});

// Later: panel.update({ ... }) to change options, panel.unmount() to remove it.`;

const view = `import { collectionView } from "@mdbase-dev/ui/collections";

const view = collectionView(mdbase.getSnapshot(), { appName: "Worklog" });
// view.kind names the screen to draw, with that screen's wording and controls.`;

const links = `import { mdbaseAppHref } from "@mdbase-dev/ui/apps";

// The collection open in this page, opened in the Editor.
editorLink.href = mdbaseAppHref("https://editor.mdbase.dev/", location.href);`;
---

<DocsLayout
  title="UI components"
  description="@mdbase-dev/ui has the sign-in, collection picker, approval and setup screens that mdbase’s own apps use, as React components."
  active="ui"
  headings={[
    { href: "#install", label: "Install" },
    { href: "#gate", label: "CollectionGate" },
    { href: "#switcher", label: "CollectionSwitcher" },
    { href: "#parts", label: "Smaller parts" },
    { href: "#style", label: "Restyle" },
    { href: "#wording", label: "Wording and language" },
    { href: "#mount", label: "Apps that do not use React" },
    { href: "#apps", label: "Links to the mdbase apps" }
  ]}
>
  <p>
    Every app built on mdbase needs the same screens before its own: sign
    in, pick a collection, approve access, review setup, and explain a
    problem. This package has them, so users meet the same flow in every app
    and you write none of it.
  </p>

  <h2 id="install">Install</h2>
  <CodeBlock code={install} language="sh" label="Terminal" />
  <p>
    The components need React 19.2 or later. <code>@mdbase-dev/i18n</code>
    {" "}and the two Lingui packages are peer dependencies. Import the
    stylesheet once, anywhere in your app:
  </p>
  <CodeBlock code={css} language="ts" label="main.tsx" />

  <h2 id="gate">CollectionGate</h2>
  <p>
    The gate takes your <a href="/sdk/lifecycle/"><code>createMdbase()</code></a>
    {" "}entry and shows the right screen for each phase. It renders its
    children once a collection is open, and starts the SDK itself.
  </p>
  <CodeBlock code={app} language="tsx" label="App.tsx" />
  <table class="api-table">
    <thead>
      <tr>
        <th>Prop</th>
        <th>Meaning</th>
      </tr>
    </thead>
    <tbody>
      <tr><td><code>mdbase</code></td><td>The entry from <code>createMdbase()</code>.</td></tr>
      <tr><td><code>app</code></td><td><code>name</code>, and optionally <code>mark</code>: an element shown as your app’s icon.</td></tr>
      <tr><td><code>children</code></td><td>A function of the open connection. Called in the <code>ready</code> and <code>unsynced</code> phases.</td></tr>
      <tr><td><code>layout</code></td><td><code>"page"</code> (default) fills the viewport. <code>"panel"</code> sits inside your own shell or dialog.</td></tr>
      <tr><td><code>unsynced</code></td><td>Show the <a href="/sdk/unsynced/">work before connecting</a> screens. Pass <code>true</code>, or <code>&#123; storage, map &#125;</code>.</td></tr>
      <tr><td><code>extraActions</code></td><td>Your own links or buttons on the gate’s screens, such as “Try a sample”.</td></tr>
      <tr><td><code>onBeforeLeave</code></td><td>Called before anything that leaves the open collection. Return <code>false</code>, or a promise of it, to stay.</td></tr>
      <tr><td><code>autoStart</code></td><td>Call <code>mdbase.start()</code> on mount. Default true.</td></tr>
      <tr><td><code>copy</code></td><td>Replacement wording. See <a href="#wording">below</a>.</td></tr>
    </tbody>
  </table>
  <CodeBlock code={gateProps} language="tsx" label="App.tsx" />
  <p>
    While a collection is open, the gate shows a banner above your app for a
    live problem, such as access that was removed.
  </p>

  <h2 id="switcher">CollectionSwitcher</h2>
  <p>
    The control inside your app for the open collection. It lists the
    approved collections, and has “Add a collection”, “Manage access” and the
    account with sign-out. It takes the same <code>mdbase</code>,
    {" "}<code>app</code>, <code>unsynced</code> and
    {" "}<code>onBeforeLeave</code> props as the gate.
  </p>
  <CodeBlock code={switcher} language="tsx" label="Header.tsx" />

  <h2 id="parts">Smaller parts</h2>
  <table class="api-table">
    <thead>
      <tr>
        <th>Export</th>
        <th>Use</th>
      </tr>
    </thead>
    <tbody>
      <tr><td><code>CollectionPanel</code></td><td>The gate’s screens and the switcher’s list in one panel, for a settings dialog or an app that opens on its own screen first.</td></tr>
      <tr><td><code>CollectionProblem</code></td><td>One problem with its fix, as a block or a banner.</td></tr>
      <tr><td><code>CollectionSetupReview</code></td><td>The setup review on its own.</td></tr>
      <tr><td><code>CollectionUnsyncedLine</code>, <code>CollectionBringIn</code></td><td>The “saved only in this browser” line and the offer to bring that work in.</td></tr>
      <tr><td><code>CollectionSaveWarning</code></td><td>A warning when unsaved changes sit in storage the browser may clear.</td></tr>
      <tr><td><code>useCollectionUi()</code></td><td>The state and actions behind the components, for a layout of your own.</td></tr>
    </tbody>
  </table>
  <CodeBlock code={problem} language="tsx" label="Problem.tsx" />
  <p>
    All of them are exported from <code>@mdbase-dev/ui/collections</code>.
  </p>

  <h2 id="style">Restyle</h2>
  <p>
    The stylesheet is self-contained. It follows the system’s light or dark
    setting; put <code>data-theme="light"</code> or
    {" "}<code>data-theme="dark"</code> on the root element to fix one. Set
    {" "}<code>--mdbase-collections-*</code> custom properties on any
    ancestor to match your app:
  </p>
  <CodeBlock code={theme} language="css" label="worklog.css" />
  <table class="api-table">
    <thead>
      <tr>
        <th>Properties</th>
        <th>Control</th>
      </tr>
    </thead>
    <tbody>
      <tr><td><code>-accent</code>, <code>-on-accent</code></td><td>Primary buttons and focus</td></tr>
      <tr><td><code>-canvas</code>, <code>-surface</code>, <code>-border</code>, <code>-current-bg</code></td><td>Backgrounds and lines</td></tr>
      <tr><td><code>-text</code>, <code>-text-soft</code>, <code>-danger</code>, <code>-warning</code></td><td>Text and status colours</td></tr>
      <tr><td><code>-font</code>, <code>-font-size</code>, <code>-font-size-caption</code>, <code>-font-size-section</code>, <code>-font-size-heading</code>, <code>-font-weight-strong</code></td><td>Type</td></tr>
      <tr><td><code>-radius-sm</code>, <code>-radius</code>, <code>-radius-lg</code>, <code>-control-height</code></td><td>Shape and size</td></tr>
      <tr><td><code>-elevation-low</code>, <code>-elevation-high</code>, <code>-scrim</code></td><td>Shadows and the dialog backdrop</td></tr>
    </tbody>
  </table>

  <h2 id="wording">Wording and language</h2>
  <p>
    The components are in English by default and need no provider. Pass
    {" "}<code>copy</code> to replace individual strings;
    {" "}<code>defaultCollectionCopy</code> lists every key.
  </p>
  <p>
    The package also ships its strings in French, German, Spanish, Italian,
    Portuguese, Russian, Japanese, Korean and Chinese.
    {" "}<code>@mdbase-dev/ui/i18n</code> exports them as
    {" "}<code>uiCatalogues</code>, for an app that sets up
    {" "}<code>@mdbase-dev/i18n</code> with its own Lingui catalogue.
  </p>

  <h2 id="mount">Apps that do not use React</h2>
  <p>
    <code>mountCollectionUi()</code> renders a component into an element you
    give it. Your app needs no React code of its own, though the
    {" "}<code>react</code> and <code>react-dom</code> packages must be
    installed.
  </p>
  <CodeBlock code={mount} language="ts" label="main.ts" />
  <p>
    <code>part</code> is <code>"panel"</code>, <code>"switcher"</code> or
    {" "}<code>"problem"</code>. To draw everything yourself and keep only the
    logic, <code>collectionView()</code> turns a snapshot into the screen to
    show:
  </p>
  <CodeBlock code={view} language="ts" label="view.ts" />

  <h2 id="apps">Links to the mdbase apps</h2>
  <p>
    A collection your app uses can also be opened in mdbase’s
    {" "}<a href="/apps/">Editor, Reader and Writer</a>.
    {" "}<code>mdbaseAppHref()</code> builds a link to one of them that opens
    the collection named in the current page’s URL:
  </p>
  <CodeBlock code={links} language="ts" label="links.ts" />
  <p>
    The <code>AppSwitcher</code> component in the same package is the menu
    mdbase’s own apps show under their name. It lists only those three apps,
    so it is not a place to add yours.
  </p>
</DocsLayout>
