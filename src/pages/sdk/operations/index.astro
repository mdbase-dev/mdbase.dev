---
import DocsLayout from "../../../components/DocsLayout.astro";
import CodeBlock from "../../../components/CodeBlock.astro";

const readQuery = `const record = await connection.read({ path: "tasks/release.md" });
if (!record.ok) return renderProblem(record.problem);

const open = await connection.query({
  types: ["task"],
  where: 'status == "open" && due != null',
  orderBy: [{ field: "due", direction: "asc" }],
  limit: 100
});
if (!open.ok) return renderProblem(open.problem);`;

const pageQuery = `let loaded = 0;
for await (const page of connection.queryPages(
  { types: ["task"], where: 'status != "done"' },
  { firstPageSize: 100, pageSize: 1000, signal: abortController.signal }
)) {
  if (!page.ok) return renderProblem(page.problem);
  appendRows(page.value.results);
  renderProgress(loaded += page.value.results.length);
}`;

const createUpdate = `const created = await connection.create({
  path: "tasks/release.md",
  type: "task",
  frontmatter: { type: "task", title: "Prepare release", status: "open" },
  body: "Release checklist."
});
if (!created.ok) return renderProblem(created.problem);

const updated = await connection.update({
  path: created.value.path,
  patch: { status: "done" },
  ifRevision: created.value.revision
});
if (!updated.ok && updated.problem.code === "concurrent_modification") {
  // Changed since it was read: refresh, then let the user or domain logic decide.
}`;

const watch = `const lifetime = new AbortController();
const opened = await connection.watch({ lifetimeSignal: lifetime.signal }, { timeoutMs: 20_000 });
if (!opened.ok) return renderProblem(opened.problem);
const unsubscribe = opened.value.subscribe(
  (change) => applyChange(change.type, change.payload.path),
  renderWatchStatus,
  renderProblem
);
// Leaving: unsubscribe(); opened.value.close();
void unsubscribe;`;

const preflight = `const preview = await connection.preflightRename({
  from: "tasks/release.md",
  to: "archive/release.md",
  updateRefs: true,
  ifRevision: current.revision
});
if (!preview.ok) return renderProblem(preview.problem);
showImpact(preview.value.referencesAffected, preview.value.warnings);

const renamed = await connection.renameWithProgress({
  from: preview.value.from,
  to: preview.value.to,
  updateRefs: true,
  ifRevision: current.revision
}, {
  preflight: preview.value,
  signal: abortController.signal,
  onProgress: renderMutationProgress
});
if (!renamed.ok) renderProblem(renamed.problem);`;

const recover = `for (const pending of connection.pendingMutations()) {
  const recovered = await pending.recover({ timeoutMs: 30_000 });
  if (!recovered.ok) renderProblem(recovered.problem);
}`;
---

<DocsLayout
  title="Records and operations"
  description="Read, query, watch, create, update, move, and delete records with typed outcomes and revision preconditions."
  active="operations"
  headings={[
    { href: "#outcomes", label: "Typed outcomes" },
    { href: "#read-query", label: "Read and query" },
    { href: "#pagination", label: "Pagination" },
    { href: "#write", label: "Write safely" },
    { href: "#watch", label: "Watch changes" },
    { href: "#preflight", label: "Preflight mutations" },
    { href: "#recovery", label: "Interrupted writes" }
  ]}
>
  <h2 id="outcomes">Typed outcomes</h2>
  <p>
    Every operation returns a <code>ConnectOutcome</code>. Check{" "}
    <code>ok</code>: a success has the typed <code>value</code> and any
    non-fatal <code>diagnostics</code>; a failure has a <code>problem</code>{" "}
    with a stable <code>code</code>, a <code>category</code>, a suggested{" "}
    <code>recovery</code>, and, for mutations, whether the write was sent,
    rejected or has an unknown outcome. Expected failures are data, not
    exceptions; exceptions mean a programming error.
  </p>
  <p>
    Record conditions have one code whichever authority holds the collection:
    a stale revision is <code>concurrent_modification</code>, a missing record
    is <code>file_not_found</code>, and invalid input is{" "}
    <code>operation_invalid</code> with the mdbase diagnostics in its details.
  </p>

  <h2 id="read-query">Read one path or query a collection</h2>
  <CodeBlock code={readQuery} language="ts" label="records.ts" />
  <p>
    Results contain effective frontmatter, raw frontmatter where applicable,
    matched types, file metadata, and a revision. CEL evaluates against
    effective values. Defaults and computed fields participate in evaluation;
    the source file remains unchanged.
  </p>

  <h2 id="pagination">Page large result sets against one snapshot</h2>
  <CodeBlock code={pageQuery} language="ts" label="large-query.ts" />
  <p>
    <code>queryPages()</code> yields one outcome per page. It preserves the
    snapshot token returned by the first page and reports a changed token as
    {" "}<code>query_snapshot_changed</code>. <code>queryAll()</code> provides the
    same behavior when holding the complete result set in memory is acceptable.
  </p>

  <h2 id="write">Create and update with explicit revisions</h2>
  <CodeBlock code={createUpdate} language="ts" label="write.ts" />
  <p>
    <code>patch</code> is the canonical v0.3 partial-frontmatter update. A
    mismatched <code>ifRevision</code> produces{" "}
    <code>concurrent_modification</code>. Refresh the record and ask the user or
    domain logic to resolve the conflict before submitting another write.
  </p>

  <p>
    For a record people are typing into, use a{" "}
    <a href="/sdk/editing/">record session</a> instead of issuing updates
    yourself.
  </p>

  <h2 id="watch">Resume changes by cursor</h2>
  <CodeBlock code={watch} language="ts" label="watch.ts" />
  <p>
    <code>watch()</code> starts within a bounded budget and returns a
    subscription that lasts until <code>close()</code> or its lifetime signal.
    It resumes from the collection authority's change cursor, reconnects
    transient routes by default, and reports a <code>reset_required</code>{" "}
    status when the consumer must refresh a complete view. To keep open
    records current, pass the subscription to{" "}
    <a href="/sdk/editing/#follow"><code>connection.records.follow()</code></a>.
  </p>

  <h2 id="preflight">Show authoritative impact before destructive work</h2>
  <CodeBlock code={preflight} language="ts" label="rename.ts" />
  <p>
    Preflight calculates the canonical operation's impact and preserves both
    records and the change cursor. Reuse its result in{" "}
    <code>renameWithProgress()</code> or <code>deleteWithProgress()</code> so
    the confirmation shown to the user matches the operation that will run.
  </p>
  <h2 id="recovery">Recover interrupted writes exactly</h2>
  <CodeBlock code={recover} language="ts" label="recover.ts" />
  <p>
    The SDK stores each mutation's exact encrypted request before sending it.
    If the response is lost, the write fails with{" "}
    <code>operation_outcome_unknown</code> and a durable handle appears in{" "}
    <code>pendingMutations()</code>, including after a reload.{" "}
    <code>recover()</code> resends the original request identity; never repeat
    the write as a new mutation. Record sessions do this for you.
  </p>
</DocsLayout>
