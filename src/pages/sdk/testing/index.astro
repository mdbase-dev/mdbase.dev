---
import DocsLayout from "../../../components/DocsLayout.astro";
import CodeBlock from "../../../components/CodeBlock.astro";

const sandbox = `import { describe, expect, it } from "vitest";
import { connect, isMdbaseError } from "@mdbase-dev/sdk";
import { MemoryReplica } from "@mdbase-dev/sdk/testing";
import { completeTask } from "../src/tasks";

async function setup() {
  const replica = new MemoryReplica({ confirmDelayMs: null });
  const { id } = replica.seed({
    path: "tasks/plan.md",
    types: ["task"],
    frontmatter: { title: "Plan", status: "open" },
  });
  const db = await connect({
    connector: replica.connector(),
    app: { name: "dev.example.test", version: "0.0.0" },
  });
  return { replica, db, id };
}

describe("completeTask", () => {
  it("shows the change before it is confirmed", async () => {
    const { replica, db, id } = await setup();
    const write = await completeTask(db, id);
    expect(write.state).toBe("pending");
    expect((await db.get(id)).frontmatter.get("status")).toBe("done");

    replica.confirmAll();
    await expect(write.confirmed).resolves.toMatchObject({ state: "confirmed" });
    db.close();
  });

  it("reports a rejected write", async () => {
    const { replica, db, id } = await setup();
    const write = await completeTask(db, id);
    replica.reject(write.mutationId);
    await expect(write.confirmed).rejects.toSatisfy((e) => isMdbaseError(e));
    db.close();
  });
});`;

const where = `const replica = new MemoryReplica({
  // MemoryReplica does not parse expressions. Supply your own evaluator.
  where: (expr, record) =>
    expr === 'status == "open"' && record.frontmatter.get("status") === "open",
});`;
---

<DocsLayout
  title="Testing"
  description="Test your app against MemoryReplica, an in-memory replica that speaks the real protocol. Keep merge and permission behaviour for tests against a real collection."
  active="testing"
  headings={[
    { href: "#sandbox", label: "Unit tests" },
    { href: "#coverage", label: "What it covers" },
    { href: "#editing", label: "Controls" },
    { href: "#real", label: "What it doesn’t cover" }
  ]}
>
  <p>
    <code>MemoryReplica</code> from <code>@mdbase-dev/sdk/testing</code> is an
    in-memory replica. It speaks the same protocol as a real one: frames,
    pushes and receipts. Your code connects to it with
    {" "}<code>connect()</code> and gets an ordinary
    {" "}<code>MdbaseClient</code>.
  </p>

  <h2 id="sandbox">Unit tests</h2>
  <CodeBlock code={sandbox} language="ts" label="tasks.test.ts" />

  <h2 id="coverage">What it covers</h2>
  <ul>
    <li>Reads, queries with cursors, live queries and the change feed.</li>
    <li>Creates, updates, renames and deletes, with receipts and <code>ifRevision</code>.</li>
    <li>Sync status and pending writes. Holds and conflicts are empty until you add one with <code>hold(ref)</code> or <code>conflict(ref, &#123; field, kept, lost &#125;)</code>.</li>
    <li>Files: upload, download and listing.</li>
    <li>Record sessions from <code>db.records.open()</code>.</li>
  </ul>
  <p>
    <code>where</code> needs an evaluator you supply.
    {" "}<code>order_by</code> sorts on <code>file.path</code> and top-level
    frontmatter fields.
  </p>
  <CodeBlock code={where} language="ts" label="where.ts" />

  <h2 id="editing">Controls</h2>
  <table class="api-table">
    <thead>
      <tr>
        <th>Call</th>
        <th>Use it to</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><code>new MemoryReplica(&#123; confirmDelayMs &#125;)</code></td>
        <td>
          Confirm writes after a delay (0 ms by default), or pass
          {" "}<code>null</code> to confirm only when you say so
        </td>
      </tr>
      <tr>
        <td><code>seed(&#123; path, types, frontmatter, body &#125;)</code></td>
        <td>Add a confirmed record before the test</td>
      </tr>
      <tr>
        <td><code>confirmAll()</code></td>
        <td>Confirm every pending write</td>
      </tr>
      <tr>
        <td><code>reject(mutationId, problem?)</code></td>
        <td>Reject one write (by default with <code>conflict</code>, reason <code>revision</code>)</td>
      </tr>
      <tr>
        <td><code>setOnline(false)</code></td>
        <td>Act as if the log can’t be reached: status reports offline and writes stay pending</td>
      </tr>
      <tr>
        <td><code>dropConnections()</code></td>
        <td>Cut the link, to test reconnects</td>
      </tr>
      <tr>
        <td><code>refuse</code>, <code>role</code>, <code>capabilities</code> options</td>
        <td>Refuse the connection with a problem, or set what <code>hello</code> reports</td>
      </tr>
    </tbody>
  </table>
  <p>
    <code>createApplicationFixture()</code> stands in for
    {" "}<code>MdbaseConnect</code>, so you can test your app’s sign-in and
    readiness screens with snapshots you control.
  </p>

  <h2 id="real">What it doesn’t cover</h2>
  <p>
    <code>MemoryReplica</code> is not the replica. It applies patches
    blindly, has no query planner and does not merge. Test these against a
    real collection:
  </p>
  <ul>
    <li>field and body merges;</li>
    <li>query expressions, type validation and defaults;</li>
    <li>grants and permission errors;</li>
    <li>when real holds and conflicts happen;</li>
    <li>routing to a Private collection.</li>
  </ul>
</DocsLayout>
