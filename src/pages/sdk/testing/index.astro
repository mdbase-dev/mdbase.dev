---
import DocsLayout from "../../../components/DocsLayout.astro";
import CodeBlock from "../../../components/CodeBlock.astro";

const sandbox = `import { createSandbox } from "@mdbase-dev/connect-dev";
import type { JsonObject } from "@mdbase-dev/connect";
import type { MdbaseCollectionClient } from "@mdbase-dev/connect/advanced";

interface Task extends JsonObject {
  type: "task";
  title: string;
  status: "open" | "done";
}

// Feature logic under test: depends only on the collection client.
async function openTasks(client: MdbaseCollectionClient<Task>) {
  const tasks = await client.queryAll({ types: ["task"] });
  if (!tasks.ok) return tasks;
  return {
    ...tasks,
    value: tasks.value.results.filter((task) => task.effectiveFrontmatter?.status === "open")
  };
}

const { client } = createSandbox<Task>({
  records: [
    { path: "tasks/first.md", types: ["task"], frontmatter: { type: "task", title: "First", status: "open" } },
    { path: "tasks/done.md", types: ["task"], frontmatter: { type: "task", title: "Done", status: "done" } }
  ]
});

const result = await openTasks(client);
if (!result.ok) throw new Error(result.problem.message);
expect(result.value.map((task) => task.path)).toEqual(["tasks/first.md"]);`;

const editing = `import { createRecordTestAuthority } from "@mdbase-dev/connect-testing";

const authority = createRecordTestAuthority();
authority.seed("Notes/one.md", { body: "Original" });
authority.records.follow(authority.watch);

// Mount the editor with authority.records where it expects connection.records.
const opened = await authority.records.open("Notes/one.md");
if (!opened.ok) throw new Error(opened.problem.message);
opened.value.session.setBody("Mine");

authority.editElsewhere("Notes/one.md", { body: "Theirs" });
await vi.runAllTimersAsync();
expect(opened.value.session.getSnapshot().state).toBe("conflict");`;

const ci = `pnpm exec mdbase-connect-dev validate-manifest \\
  public/.well-known/mdbase-app.json

pnpm test

# Run semantic and route tests against the real local stack.
pnpm e2e`;
---

<DocsLayout
  title="Testing"
  description="Use the transport-neutral client and deterministic sandbox for feature tests, then reserve the real connector for CEL, authorization, encryption, and route behavior."
  active="testing"
  headings={[
    { href: "#sandbox", label: "Sandbox tests" },
    { href: "#coverage", label: "Sandbox coverage" },
    { href: "#editing", label: "Editing features" },
    { href: "#real", label: "Real connector tests" },
    { href: "#ci", label: "CI sequence" }
  ]}
>
  <h2 id="sandbox">Test feature logic through MdbaseCollectionClient</h2>
  <CodeBlock code={sandbox} language="ts" label="tasks.test.ts" />
  <p>
    The sandbox implements the same small{" "}
    <code>MdbaseCollectionTransport</code> seam used by
    {" "}<code>MdbaseCollectionClient</code>. It is deterministic, requires no
    browser authorization, and exposes a snapshot helper for assertions.
  </p>

  <h2 id="coverage">What the sandbox covers</h2>
  <table class="api-table">
    <thead>
      <tr>
        <th>Covered</th>
        <th>Test with the real stack</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>Typed CRUD and outcomes</td>
        <td>CEL expression semantics</td>
      </tr>
      <tr>
        <td>Revision preconditions</td>
        <td>Query ordering semantics</td>
      </tr>
      <tr>
        <td>Type filtering and pagination</td>
        <td>OAuth, PKCE, and grant approval</td>
      </tr>
      <tr>
        <td>Read defaults</td>
        <td>Direct and encrypted relay routing</td>
      </tr>
      <tr>
        <td>Change cursors</td>
        <td>Filesystem and hosted-provider behavior</td>
      </tr>
    </tbody>
  </table>
  <p>
    The sandbox rejects <code>where</code> and <code>orderBy</code> with <code>sandbox_unsupported</code>. Run CEL
    expression and ordering tests against a conforming collection authority.
  </p>

  <h2 id="editing">Test editing features</h2>
  <CodeBlock code={editing} language="ts" label="editor.test.ts" />
  <p>
    <code>createRecordTestAuthority()</code> from
    {" "}<code>@mdbase-dev/connect-testing</code> is an in-memory authority
    with revision checks and a change watch; its <code>records</code> is the
    real <code>connection.records</code> implementation. Controls reproduce
    what other clients and the network do: <code>editElsewhere()</code>,
    {" "}<code>renameElsewhere()</code>, <code>deleteElsewhere()</code>,
    {" "}<code>loseNextResponse()</code>, <code>failNextWrite()</code> and
    {" "}<code>resetWatch()</code>, with <code>writes</code> recording what
    reached the authority.
  </p>

  <h2 id="real">Use the real stack at system boundaries</h2>
  <p>Run integration tests against the local Connect stack for:</p>
  <ul>
    <li>manifest registration and callback validation;</li>
    <li>OAuth with PKCE and refresh-token rotation;</li>
    <li>portable short-code approval, expiry, polling limits, cancellation, and key binding;</li>
    <li><code>file://</code> memory isolation, popup blocking, and exact <code>Origin: null</code> grants;</li>
    <li>grant narrowing, pausing, revocation, and operation gaps;</li>
    <li>CEL filters, ordering, links, saved views, and type behavior;</li>
    <li>direct-to-relay failover and durable mutation receipts;</li>
    <li>hosted capabilities, sync, notifications, and authority timers.</li>
  </ul>
  <p>
    Package tests should also build the dependency-free browser artifact,
    recalculate its SHA-384 value, compare it with
    {" "}<code>integrity.json</code>, and load the bundle from a real local file.
  </p>

  <h2 id="ci">Recommended CI sequence</h2>
  <CodeBlock code={ci} language="sh" label="CI" />
  <p>
    Validate the manifest before tests so a callback or requirement error is
    reported as a declaration problem. Keep deterministic feature tests fast,
    then run the real-stack suite as the release boundary.
  </p>
</DocsLayout>
