---
import DocsLayout from "../../../components/DocsLayout.astro";
import CodeBlock from "../../../components/CodeBlock.astro";
import DocText from "../../../components/DocText.astro";
import api from "../../../data/sdk-api.json";

type Member = { name: string; signature: string; description: string; deprecated?: string | boolean };
type Export = {
  name: string;
  kind: string;
  description: string;
  signature?: string;
  members?: Member[];
  deprecated?: string | boolean;
};

const slug = (specifier: string) =>
  specifier === api.package ? "core" : specifier.slice(api.package.length + 1).replace(/[^a-z0-9]+/g, "-");
const anchor = (specifier: string, name: string) => `${slug(specifier)}-${name}`;
const entries = api.entries as Array<{ specifier: string; title: string; featured: Export[]; index: Export[] }>;

// The codes and recoveries come from the SDK's types. The sentence beside each
// is written here, and the build fails when the two lists differ.
const when: Record<string, string> = {
  invalid_request: "Malformed parameters, an unsafe path, or an expired query cursor",
  invalid_record: "The write fails validation; see issues",
  not_found: "No such record, file, hold or transfer",
  conflict: "The current state does not allow this write; reason says why, such as revision or path_taken",
  unauthenticated: "No session, an expired one, or a revoked grant",
  forbidden: "The grant lacks the capability, or the person’s role does not allow it",
  collection_invalid: "The collection’s configuration or type files cannot be loaded",
  unavailable: "The replica cannot be reached, for example when no device is online",
  rate_limited: "Too many requests; see retryAfterMs",
  quota_exceeded: "The collection is over its storage quota",
  too_large: "A request or file is over its limit",
  upgrade_required: "This SDK version is too old for the replica or the collection",
  outcome_unknown: "A write’s outcome cannot be determined; read again and decide",
  cancelled: "Your code cancelled the request",
  internal: "A bug; the request may be retried once",
};
const errors = api.errors as Array<{ code: string; recovery: string }>;
const undescribed = errors.filter((error) => !(error.code in when)).map((error) => error.code);
const stale = Object.keys(when).filter((code) => !errors.some((error) => error.code === code));
if (undescribed.length || stale.length) {
  throw new Error(
    `src/pages/sdk/api/index.astro: error codes without a description: [${undescribed}]; descriptions without a code: [${stale}]`,
  );
}
---

<DocsLayout
  title="API reference"
  description={`Generated from the type declarations of ${api.package} ${api.version}.`}
  active="api"
  headings={[
    ...entries.map((entry) => ({ href: `#${slug(entry.specifier)}`, label: entry.title })),
    { href: "#errors", label: "Errors" },
  ]}
>
  <p>
    This page is generated from the declarations published in
    {" "}<code>{api.package}</code> <code>{api.version}</code>, so every
    signature and description is the one your editor shows. The main types are
    listed in full under each entry point, followed by an index of its other
    exports. The guide pages explain how the parts fit together; start with
    {" "}<a href="/sdk/connect-quickstart/">Build an app</a>.
  </p>

  {
    entries.map((entry) => (
      <>
        <h2 id={slug(entry.specifier)}>{entry.title}</h2>
        <p>
          <code>import &#123; … &#125; from "{entry.specifier}"</code>
        </p>
        {entry.featured.map((item) => (
          <section class="api-item">
            <h3 id={anchor(entry.specifier, item.name)}>
              <code>{item.name}</code> <span class="api-kind">{item.kind}</span>
            </h3>
            {item.deprecated && (
              <p class="api-deprecated">
                Deprecated{typeof item.deprecated === "string" ? <>: <DocText text={item.deprecated} inline /></> : "."}
              </p>
            )}
            <DocText text={item.description} />
            {item.members ? (
              <dl class="api-members">
                {item.members.map((member) => (
                  <>
                    <dt>
                      <code>{member.signature}</code>
                    </dt>
                    <dd>
                      {member.deprecated && (
                        <p class="api-deprecated">
                          Deprecated{typeof member.deprecated === "string" ? <>: <DocText text={member.deprecated} inline /></> : "."}
                        </p>
                      )}
                      <DocText text={member.description} />
                    </dd>
                  </>
                ))}
              </dl>
            ) : (
              <CodeBlock code={item.signature ?? ""} language="ts" label={item.kind} />
            )}
          </section>
        ))}
        {entry.index.length > 0 && (
          <>
            <h3 id={`${slug(entry.specifier)}-exports`}>
              {entry.featured.length > 0 ? "Other exports" : "Exports"}
            </h3>
            <table class="api-table api-index">
              <thead>
                <tr>
                  <th>Name</th>
                  <th>Kind</th>
                  <th>Description</th>
                </tr>
              </thead>
              <tbody>
                {entry.index.map((item) => (
                  <tr>
                    <td>
                      <code>{item.name}</code>
                    </td>
                    <td>{item.kind}</td>
                    <td>
                      {item.deprecated ? "Deprecated. " : ""}
                      <DocText text={item.description} />
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </>
        )}
      </>
    ))
  }

  <h2 id="errors">Errors</h2>
  <p>
    Failures throw <code>MdbaseError</code> with a <code>code</code>, a
    {" "}<code>recovery</code>, and often a <code>reason</code>,
    {" "}<code>details</code>, <code>issues</code> or
    {" "}<code>retryAfterMs</code>. Check them with
    {" "}<code>isMdbaseError(error, code?)</code>. Branch on <code>code</code>
    {" "}and <code>reason</code>; <code>message</code> is for developers. A
    write the collection refuses does not throw: its <code>Write</code> has
    {" "}<code>state: "rejected"</code> and the same fields under
    {" "}<code>receipt.problem</code>. To show a failure to a person, pass it
    to <a href="#describe"><code>describeError()</code></a>.
  </p>
  <table class="api-table">
    <thead>
      <tr>
        <th>Code</th>
        <th>Recovery</th>
        <th>When</th>
      </tr>
    </thead>
    <tbody>
      {
        errors.map((error) => (
          <tr>
            <td><code>{error.code}</code></td>
            <td><code>{error.recovery}</code></td>
            <td>{when[error.code]}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</DocsLayout>
