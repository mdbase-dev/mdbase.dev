---
import DocsLayout from "../../../components/DocsLayout.astro";
import CodeBlock from "../../../components/CodeBlock.astro";

const constructor = `new MdbaseConnect<Frontmatter>({
  serverUrl: string | URL,
  manifest?: MdbaseAppManifest | string | URL,
  redirectUri?: string | URL,
  storage?: Storage,
  relayEncryption?: "required" | "disabled",
  keyStore?: GrantKeyStore,
  identityStore?: ApplicationIdentityStore,
  directAccess?: "auto" | "disabled",
  loopbackUrl?: string | URL,
  navigate?: (url: string) => void | Promise<void>,
  timeouts?: {
    requestMs?: number | null,
    watchStartMs?: number | null,
    fileIndexMs?: number | null,
    uploadMs?: number | null,
    syncMs?: number | null
  }
})`;

const session = `const session = mdbase.application({
  selection: new MdbaseBrowserSelection({
    collectionParameter: "collection",
    fallbackPath: "/"
  })
});`;

const error = `const updated = await connection.update(input);
if (!updated.ok) {
  if (updated.problem.code === "operation_invalid") {
    renderDiagnostics(updated.problem.details.diagnostics);
  } else {
    renderProblem(updated.problem.code, updated.problem.recovery);
  }
}`;
---

