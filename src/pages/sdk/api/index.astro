    </tbody>
  </table>

  <h2 id="files">Files</h2>
  <table class="api-table">
    <thead>
      <tr><th>Member of <code>db.files</code></th><th>Notes</th></tr>
    </thead>
    <tbody>
      <tr><td><code>list(&#123; folder, media &#125;)</code>, <code>listPage(…)</code>, <code>get(ref)</code></td><td><code>FileView</code>: <code>id</code>, <code>path</code>, <code>size</code>, <code>digest</code>, <code>media</code>, <code>state</code></td></tr>
      <tr><td><code>upload(path, source, &#123; onProgress, transferId, fileId, ifRevision, signal &#125;)</code></td><td><code>source</code>: <code>Uint8Array</code>, <code>ArrayBuffer</code> or <code>Blob</code></td></tr>
