---
import DocsLayout from "../../../components/DocsLayout.astro";
import CodeBlock from "../../../components/CodeBlock.astro";

const manifest = `{
  "manifest_version": 1,
  "id": "dev.example.worklog",
  "name": "Worklog",
  "homepage": "https://worklog.example",
  "redirect_uris": ["https://worklog.example/auth/mdbase/callback"],
  "requirements": {
    "access": "full_collection",
    "contracts": [],
    "capabilities": {
      "contract_version": 2,
      "required": ["collection.read", "records.create", "records.edit"]
    }
  }
}`;

const install = `npm install @mdbase-dev/sdk`;

const client = `import { MdbaseConnect } from "@mdbase-dev/sdk";
import manifest from "./mdbase-app.json";

export const mdbase = new MdbaseConnect({
  id: WORKLOG_APPLICATION_ID, // your app’s registered application ID
  name: "Worklog",
  origin: "https://worklog.example",
  environment: "production",
  manifest,
});

export const app = mdbase.application();`;

const authorize = `import { app, mdbase } from "./mdbase";

app.subscribe(() => render(app.getSnapshot()));
await app.start();

// Call authorize() straight from the click, so the browser allows its window.
signInButton.onclick = () => app.authorize();

function render(snapshot) {
  // "signed_out", "authorizing", "unselected", "setup_required", "ready", …
  showScreen(snapshot.status);
  if (snapshot.status === "unselected") {
    showPicker(snapshot.collections, (id) => app.select(id));
  }
  if (snapshot.status === "ready" && snapshot.selectedCollectionId) {
    const connection = mdbase.connection(snapshot.selectedCollectionId);
    if (connection) startApp(connection.records);
  }
}`;

const operate = `async function startApp(db) {
  const entries = db.live({
    types: ["worklog_entry"],
    order_by: [{ field: "date", direction: "desc" }],
    limit: 50,
  });
  entries.subscribe((state) => renderEntries(state.records));

  addButton.onclick = () =>
    db.create({
      type: "worklog_entry",
      frontmatter: { date: today(), summary: summaryInput.value },
    });
}`;
---

<DocsLayout
  title="Connect a browser app"
  description="Declare your app, let the user sign in and pick a collection, then use the connection’s client."
  active="connect-quickstart"
  headings={[
    { href: "#before", label: "Status" },
    { href: "#manifest", label: "1. Write a manifest" },
    { href: "#install", label: "2. Install" },
    { href: "#client", label: "3. Declare the app" },
    { href: "#authorize", label: "4. Sign in and pick" },
    { href: "#operate", label: "5. Use the collection" },
    { href: "#production", label: "Origins" }
  ]}
>
  <div class="callout" id="before">
    <strong>This flow is not available yet.</strong>
    <p>
      <code>MdbaseConnect</code> is in the SDK with its final shape, but it
      does not sign anyone in yet. In current builds, <code>getSnapshot()</code>
      {" "}reports status <code>"blocked"</code> with problem
      {" "}<code>application_not_yet_available</code>, and the other methods
      reject with <code>MdbaseApplicationUnavailableError</code>. Write and test
      your app against it now with
      {" "}<a href="/sdk/testing/">createApplicationFixture()</a>. This page
      will say when it works against real collections.
    </p>
  </div>

  <h2 id="manifest">1. Write a manifest</h2>
  <p>
    The manifest says who your app is and what it needs. Ask only for the
    capabilities you use; see <a href="/sdk/authorization/">Authorization</a>.
  </p>
  <CodeBlock code={manifest} language="json" label="mdbase-app.json" />

  <h2 id="install">2. Install</h2>
  <CodeBlock code={install} language="sh" label="Terminal" />
  <p>
    The package is not on npm yet; see the
    {" "}<a href="/sdk/quickstart/#build">quickstart</a>.
  </p>

  <h2 id="client">3. Declare the app</h2>
  <CodeBlock code={client} language="ts" label="mdbase.ts" />
  <p>
    Create one <code>MdbaseConnect</code> for your app. <code>origin</code> must
    be the exact origin your app is served from.
  </p>

  <h2 id="authorize">4. Sign in and pick a collection</h2>
  <CodeBlock code={authorize} language="ts" label="main.ts" />
  <p>
    Render from the snapshot. It tells you where the user is: signed out,
    signing in, choosing a collection, or ready. When a collection needs
    set-up first, the status is <code>setup_required</code>;
    {" "}<code>assess()</code> says why and <code>configure()</code> applies
    what your manifest declares.
  </p>
  <p>
    <code>forget(id)</code> removes a collection from your app’s list on this
    device. It does not revoke access or delete anything.
  </p>

  <h2 id="operate">5. Use the collection</h2>
  <p>
    <code>connection.records</code> is an ordinary <code>MdbaseClient</code>.
    Everything in <a href="/sdk/operations/">Records and operations</a> applies.
  </p>
  <CodeBlock code={operate} language="ts" label="worklog.ts" />

  <h2 id="production">Origins</h2>
  <p>
    <code>origin</code> must use HTTPS. Browser extension origins
    ({" "}<code>chrome-extension:</code> and <code>moz-extension:</code>) are
    also accepted. The manifest’s <code>homepage</code> and
    {" "}<code>redirect_uris</code> must be HTTPS too.
  </p>
</DocsLayout>
