---
import DocsLayout from "../../../components/DocsLayout.astro";
import CodeBlock from "../../../components/CodeBlock.astro";

const manifest = `{
  "manifest_version": 1,
  "id": "dev.example.worklog",
  "name": "Worklog",
  "homepage": "https://worklog.example",
  "redirect_uris": ["https://worklog.example/auth/mdbase/callback"],
  "requirements": {
    "access": "full_collection",
    "contracts": [],
    "capabilities": {
      "contract_version": 2,
      "required": ["collection.read", "records.create", "records.edit"]
    }
  }
}`;

const install = `npm install @mdbase-dev/sdk`;

const client = `import { createMdbase } from "@mdbase-dev/sdk";
import manifest from "./mdbase-app.json";

export const mdbase = createMdbase({
  id: "dev.example.worklog",
  name: "Worklog", // must match the manifest's name
  origin: "https://worklog.example",
  environment: "production",
  manifest,
});`;

const authorize = `import { mdbase } from "./mdbase";

mdbase.subscribe(() => render(mdbase.getSnapshot()));
await mdbase.start();

// Call signIn() straight from the click, so the browser allows its window.
signInButton.onclick = () => mdbase.signIn();

function render(snapshot) {
  const { phase } = snapshot;
  // "signed_out", "authorizing", "choosing", "needs_setup", "ready", …
  showScreen(phase.kind);
  if (phase.kind === "choosing") {
    showPicker(snapshot.collections, (id) => mdbase.select(id));
  }
  if (phase.kind === "ready") startApp(phase.connection.records);
}`;

const operate = `async function startApp(db) {
  const entries = db.live({
    types: ["worklog_entry"],
    order_by: [{ field: "date", direction: "desc" }],
    limit: 50,
  });
  entries.subscribe((state) => renderEntries(state.records));

  addButton.onclick = () =>
    db.create({
      type: "worklog_entry",
      frontmatter: { date: today(), summary: summaryInput.value },
    });
}`;
---

<DocsLayout
  title="Connect a browser app"
  description="Declare your app, let the user sign in and pick a collection, then use the connection’s client."
  active="connect-quickstart"
  headings={[
    { href: "#before", label: "Status" },
    { href: "#manifest", label: "1. Write a manifest" },
    { href: "#install", label: "2. Install" },
    { href: "#client", label: "3. Declare the app" },
    { href: "#authorize", label: "4. Sign in and pick" },
    { href: "#operate", label: "5. Use the collection" },
    { href: "#production", label: "Origins" }
  ]}
>
  <div class="callout" id="before">
    <strong>The SDK is not on npm yet.</strong>
    <p>
      Signing in to real collections needs a packaged SDK release, and none is
      published yet. Until then, write and test your app against
      {" "}<a href="/sdk/testing/">createApplicationFixture()</a>.
      This page will say when a release is out.
    </p>
  </div>

  <h2 id="manifest">1. Write a manifest</h2>
  <p>
    The manifest says who your app is and what it needs. Ask only for the
    capabilities you use; see <a href="/sdk/authorization/">Authorization</a>.
  </p>
  <CodeBlock code={manifest} language="json" label="mdbase-app.json" />

  <h2 id="install">2. Install</h2>
  <CodeBlock code={install} language="sh" label="Terminal" />
  <p>
    The package is not on npm yet; see the
    {" "}<a href="/sdk/quickstart/#build">quickstart</a>.
  </p>

  <h2 id="client">3. Declare the app</h2>
  <CodeBlock code={client} language="ts" label="mdbase.ts" />
  <p>
    Create one <code>createMdbase()</code> entry for your app.
    {" "}<code>origin</code> must be the exact origin your app is served from.
    The SDK registers your manifest with mdbase when the app starts, so you
    don’t need an ID from mdbase first. <code>MdbaseConnect</code> is the same
    entry under its previous name.
  </p>

  <h2 id="authorize">4. Sign in and pick a collection</h2>
  <CodeBlock code={authorize} language="ts" label="main.ts" />
  <p>
    Render from the snapshot’s <code>phase</code>. It tells you where the user
    is: signed out, signing in, choosing a collection, or ready. Switch on
    {" "}<code>phase.kind</code> rather than building your own ready check.
    When a collection needs set-up first, the phase is
    {" "}<code>needs_setup</code>;
    {" "}<code>assess()</code> says why and <code>configure()</code> applies
    what your manifest declares.
  </p>
  <p>
    <code>forget(id)</code> removes a collection from your app’s list on this
    device. It does not revoke access or delete anything.
  </p>

  <h2 id="operate">5. Use the collection</h2>
  <p>
    <code>connection.records</code> is an ordinary <code>MdbaseClient</code>.
    Everything in <a href="/sdk/operations/">Records and operations</a> applies.
  </p>
  <CodeBlock code={operate} language="ts" label="worklog.ts" />

  <h2 id="production">Origins</h2>
  <p>
    <code>origin</code> is normally your manifest’s HTTPS
    {" "}<code>homepage</code> origin. A Capacitor shell
    ({" "}<code>capacitor://</code>) or Chrome extension
    ({" "}<code>chrome-extension://</code>) origin must also be listed under the
    manifest’s <code>installation_origins</code>. Firefox extension origins are
    not accepted. Browser <code>redirect_uris</code> must be HTTPS on the
    homepage origin; a native app can use a private-use scheme based on its
    manifest ID.
  </p>
</DocsLayout>
