---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="mdbase Connect"
  description="Choose which apps can use a local folder or hosted mdbase collection, review exact permissions, and revoke access at any time."
  current="connect"
>
  <section class="connect-opening">
    <div class="connect-opening__copy">
      <p class="eyebrow">Connect private beta</p>
      <h1>Choose which apps can use your Markdown.</h1>
      <p class="connect-opening__lead">
        When an app asks to use a collection, Connect shows whether it wants
        to view, change, or delete records. You choose the collection and can
        change or revoke access at any time.
      </p>
      <div class="button-row">
        <a class="button button--primary" href="/beta/">Request beta access</a>
        <a class="button" href="#how-connect-works">See how Connect works</a>
      </div>
    </div>

    <figure class="connect-example" aria-label="Example Connect access request">
      <figcaption>Example access request</figcaption>
      <div class="connect-request">
        <header class="connect-request__header">
          <div>
            <p class="eyebrow">Access request</p>
            <p class="connect-request__app">Project app</p>
          </div>
          <span class="connect-request__status">Waiting for you</span>
        </header>

        <div class="connect-request__section">
          <div>
            <strong>Collection</strong>
            <small>Choose where Project app can work.</small>
          </div>
          <div class="connect-request__collection">
            <span>Projects</span>
            <small>On this computer</small>
          </div>
        </div>

        <div class="connect-request__section">
          <div>
            <strong>Permissions</strong>
            <small>Open the details to narrow access.</small>
          </div>
          <ul class="connect-request__permissions">
            <li>
              <span class="permission-state permission-state--selected" aria-hidden="true">✓</span>
              <span>View and find records</span>
            </li>
            <li>
              <span class="permission-state permission-state--selected" aria-hidden="true">✓</span>
              <span>Create and edit records</span>
            </li>
            <li class="permission-unselected">
              <span class="permission-state" aria-hidden="true"></span>
              <span>Delete records</span>
            </li>
          </ul>
        </div>

        <footer class="connect-request__footer">
          <p>
            Project app will use Projects until you revoke access.
          </p>
          <div class="connect-request__actions" aria-hidden="true">
            <span>Deny</span>
            <span class="connect-request__allow">Allow Project app</span>
          </div>
        </footer>
      </div>
    </figure>
  </section>

  <section class="connect-section connect-how" id="how-connect-works">
    <header class="connect-section__intro">
      <p class="eyebrow">How it works</p>
      <h2>Start in the app.</h2>
      <p>
        Connect keeps the request open while you sign in, choose a collection,
        and decide what the app may do.
      </p>
    </header>

    <ol class="connect-steps" aria-label="Using an app with mdbase Connect">
      <li>
        <span>01</span>
        <div>
          <h3>An app asks for access</h3>
          <p>
            The request names the app and the actions it needs. The app cannot
            use a collection before you make a decision.
          </p>
        </div>
      </li>
      <li>
        <span>02</span>
        <div>
          <h3>You choose the collection and permissions</h3>
          <p>
            Use a folder on this computer or a hosted collection. Remove any
            requested permissions you do not want to grant.
          </p>
        </div>
      </li>
      <li>
        <span>03</span>
        <div>
          <h3>Connect returns you to the app</h3>
          <p>
            The approved access stays attached to that app and collection. You
            can narrow, pause, or revoke it later.
          </p>
        </div>
      </li>
    </ol>
  </section>

  <section class="connect-section connect-storage">
    <header class="connect-section__intro connect-section__intro--wide">
      <p class="eyebrow">Where your collection lives</p>
      <h2>Keep it on your computer or host it online.</h2>
      <p>
        Apps use the same approval flow in both cases. The location of the
        collection determines which component can open the records and execute
        approved operations.
      </p>
    </header>

    <div class="collection-modes">
      <article class="collection-mode">
        <header>
          <h3>Local folder</h3>
          <p>On this computer</p>
        </header>
        <div>
          <strong>Where Markdown lives</strong>
          <p>
            In an ordinary folder you choose. The files remain available to
            your text editor and other local tools.
          </p>
        </div>
        <div>
          <strong>Who can read records</strong>
          <p>
            The local connector and apps using an active grant. The Connect
            control plane cannot read local operation payloads or results.
          </p>
        </div>
      </article>

      <article class="collection-mode">
        <header>
          <h3>Hosted collection</h3>
          <p>Available online</p>
        </header>
        <div>
          <strong>Where Markdown lives</strong>
          <p>
            In encrypted provider storage, with an optional local Markdown
            mirror for offline work.
          </p>
        </div>
        <div>
          <strong>Who can read records</strong>
          <p>
            The hosted provider decrypts records to execute approved
            operations and acts as a trusted data processor.
          </p>
        </div>
      </article>
    </div>

    <div class="connect-control-note">
      <strong>Permissions can change later.</strong>
      <p>
        Narrow an app to fewer actions, pause access temporarily, or revoke the
        connection. The collection remains usable after an app is removed.
      </p>
    </div>
  </section>

  <section class="connect-closing">
    <div class="connect-closing__inner">
      <div>
        <p class="eyebrow">Connect private beta</p>
        <h2>Try Connect with your own Markdown.</h2>
        <p>
          Invitations are sent in small batches. Requesting access only needs
          your email address.
        </p>
      </div>
      <div class="button-row">
        <a class="button button--primary" href="/beta/">Request beta access</a>
        <a class="button" href="/sdk/connect-quickstart/">Build with the SDK</a>
      </div>
    </div>

    <nav class="connect-resources" aria-label="Connect technical resources">
      <span>Technical details</span>
      <a href="/sdk/authorization/">Authorization guide</a>
      <a href="/sdk/routing/">Routing guide</a>
      <a href="/security/">Security model</a>
      <a href="https://github.com/mdbase-dev/mdbase-connect/blob/main/README.md">Release status</a>
    </nav>
  </section>
</BaseLayout>

<style>
  .connect-opening,
  .connect-section,
  .connect-closing {
    width: min(100% - 2rem, var(--page));
    margin-inline: auto;
  }

  .connect-opening {
    display: grid;
    min-height: min(48rem, calc(100vh - var(--header)));
    padding-block: clamp(4rem, 8vw, 7rem);
    align-items: center;
    grid-template-columns: minmax(0, 0.78fr) minmax(26rem, 0.92fr);
    gap: clamp(3rem, 8vw, 8rem);
    border-bottom: 1px solid var(--line);
  }

  .connect-opening__copy h1 {
    max-width: 11ch;
    margin-top: 1rem;
    font-size: clamp(3rem, 5.8vw, 5.5rem);
    letter-spacing: -0.055em;
  }

  .connect-opening__lead {
    max-width: 35rem;
    margin-top: 1.5rem;
    color: var(--ink-soft);
    font-size: clamp(1rem, 1.4vw, 1.125rem);
  }

  .connect-opening__copy .button-row {
    margin-top: 1.75rem;
  }

  .connect-example {
    min-width: 0;
    padding: clamp(1rem, 2.6vw, 2rem);
    background: var(--surface);
    border: 1px solid var(--line);
  }

  .connect-example > figcaption {
    margin-bottom: 0.65rem;
    color: var(--ink-muted);
    font: 500 0.65rem/1.4 var(--mono);
  }

  .connect-request {
    background: var(--canvas);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    box-shadow: 0 1.5rem 4rem color-mix(in oklch, var(--ink) 7%, transparent);
  }

  .connect-request__header,
  .connect-request__section,
  .connect-request__footer {
    display: grid;
    padding: 1rem 1.1rem;
    grid-template-columns: minmax(9rem, 0.7fr) minmax(0, 1fr);
    gap: 1.25rem;
  }

  .connect-request__header,
  .connect-request__section {
    border-bottom: 1px solid var(--line);
  }

  .connect-request__header {
    position: relative;
    align-items: start;
  }

  .connect-request__app {
    margin-top: 0.35rem;
    color: var(--ink);
    font-size: 1.2rem;
    font-weight: 700;
    line-height: 1.1;
  }

  .connect-request__status {
    justify-self: end;
    padding: 0.28rem 0.45rem;
    color: var(--ink-soft);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 2px;
    font: 500 0.62rem/1.2 var(--mono);
  }

  .connect-request__section strong,
  .collection-mode strong {
    display: block;
    color: var(--ink);
    font-size: 0.82rem;
  }

  .connect-request__section small {
    display: block;
    margin-top: 0.25rem;
    color: var(--ink-muted);
    font-size: 0.76rem;
    line-height: 1.4;
  }

  .connect-request__collection {
    padding: 0.65rem 0.75rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 3px;
  }

  .connect-request__collection > span {
    display: block;
    color: var(--ink);
    font-size: 0.86rem;
    font-weight: 700;
  }

  .connect-request__permissions {
    padding: 0;
    list-style: none;
  }

  .connect-request__permissions li {
    display: grid;
    max-width: none;
    min-height: 2.35rem;
    padding: 0.45rem 0;
    align-items: center;
    grid-template-columns: 1.1rem minmax(0, 1fr);
    gap: 0.55rem;
    color: var(--ink);
    border-top: 1px solid var(--line);
    font-size: 0.82rem;
  }

  .connect-request__permissions li:first-child {
    border-top: 0;
  }

  .permission-state {
    display: grid;
    width: 0.95rem;
    height: 0.95rem;
    place-items: center;
    color: var(--canvas);
    border: 1px solid var(--line-strong);
    border-radius: 2px;
    font-size: 0.68rem;
    line-height: 1;
  }

  .permission-state--selected {
    background: var(--blue);
    border-color: var(--blue);
  }

  .connect-request__permissions .permission-unselected {
    color: var(--ink-muted);
  }

  .connect-request__footer {
    align-items: center;
    grid-template-columns: minmax(0, 1fr) auto;
  }

  .connect-request__footer p {
    color: var(--ink-soft);
    font-size: 0.76rem;
  }

  .connect-request__actions {
    display: flex;
    gap: 0.45rem;
  }

  .connect-request__actions span {
    display: inline-flex;
    min-height: 2rem;
    padding: 0.35rem 0.65rem;
    align-items: center;
    color: var(--ink-soft);
    background: var(--canvas);
    border: 1px solid var(--line);
    border-radius: 3px;
    font-size: 0.7rem;
    font-weight: 700;
  }

  .connect-request__actions .connect-request__allow {
    color: var(--canvas);
    background: var(--ink);
    border-color: var(--ink);
  }

  .connect-section {
    padding-block: clamp(4rem, 7vw, 6.5rem);
    border-bottom: 1px solid var(--line);
  }

  .connect-how {
    display: grid;
    grid-template-columns: minmax(15rem, 0.58fr) minmax(0, 1fr);
    gap: clamp(3rem, 9vw, 9rem);
  }

  .connect-section__intro h2 {
    max-width: 14ch;
    margin-top: 0.9rem;
  }

  .connect-section__intro > p:last-child {
    max-width: 39rem;
    margin-top: 1.15rem;
    color: var(--ink-soft);
    font-size: 1rem;
  }

  .connect-section__intro--wide h2 {
    max-width: 19ch;
  }

  .connect-steps {
    padding: 0;
    border-top: 1px solid var(--line-strong);
    list-style: none;
  }

  .connect-steps li {
    display: grid;
    max-width: none;
    padding: 1.4rem 0;
    grid-template-columns: 2.4rem minmax(0, 1fr);
    gap: 1rem;
    border-bottom: 1px solid var(--line);
  }

  .connect-steps > li > span {
    color: var(--ink-muted);
    font: 500 0.65rem/1.5 var(--mono);
  }

  .connect-steps h3 {
    max-width: none;
    font-size: 1.05rem;
  }

  .connect-steps p {
    margin-top: 0.5rem;
    color: var(--ink-soft);
    font-size: 0.95rem;
  }

  .collection-modes {
    margin-top: clamp(2.5rem, 5vw, 4.5rem);
    border-top: 1px solid var(--line-strong);
  }

  .collection-mode {
    display: grid;
    padding-block: 1.5rem;
    grid-template-columns: minmax(11rem, 0.48fr) repeat(2, minmax(0, 1fr));
    gap: clamp(1.5rem, 4vw, 4rem);
    border-bottom: 1px solid var(--line);
  }

  .collection-mode h3 {
    font-size: 1.1rem;
  }

  .collection-mode header p {
    margin-top: 0.35rem;
    color: var(--ink-muted);
    font: 500 0.65rem/1.4 var(--mono);
  }

  .collection-mode > div p {
    margin-top: 0.45rem;
    color: var(--ink-soft);
    font-size: 0.9rem;
  }

  .connect-control-note {
    display: grid;
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    grid-template-columns: minmax(11rem, 0.48fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    border-top: 1px solid var(--line-strong);
  }

  .connect-control-note strong {
    color: var(--ink);
    font-size: 1rem;
  }

  .connect-control-note p {
    max-width: 43rem;
    color: var(--ink-soft);
    font-size: 0.95rem;
  }

  .connect-closing {
    padding-block: clamp(4.5rem, 8vw, 7.5rem) 2rem;
  }

  .connect-closing__inner {
    display: grid;
    align-items: end;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 3rem;
  }

  .connect-closing h2 {
    max-width: 15ch;
    margin-top: 0.9rem;
    font-size: clamp(2.2rem, 4vw, 3.8rem);
  }

  .connect-closing__inner p:last-child {
    max-width: 38rem;
    margin-top: 1.15rem;
    color: var(--ink-soft);
    font-size: 1rem;
  }

  .connect-resources {
    display: flex;
    margin-top: clamp(3.5rem, 7vw, 6rem);
    padding-top: 1rem;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.55rem 1.35rem;
    border-top: 1px solid var(--line);
    font-size: 0.78rem;
  }

  .connect-resources span {
    color: var(--ink-muted);
    font: 500 0.65rem/1.4 var(--mono);
  }

  .connect-resources a {
    color: var(--ink-soft);
    text-decoration-color: var(--line-strong);
  }

  .connect-resources a:hover {
    color: var(--blue-strong);
  }

  @media (max-width: 60rem) {
    .connect-opening {
      min-height: auto;
      grid-template-columns: 1fr;
    }

    .connect-opening__copy {
      max-width: 42rem;
    }

    .connect-example {
      width: min(100%, 42rem);
    }

    .connect-how {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .connect-section__intro {
      max-width: 40rem;
    }
  }

  @media (max-width: 42rem) {
    .connect-opening,
    .connect-section,
    .connect-closing {
      width: min(100% - 1.25rem, var(--page));
    }

    .connect-opening {
      padding-block: 3.5rem 4rem;
      gap: 2.75rem;
    }

    .connect-opening__copy h1 {
      font-size: clamp(2.75rem, 13vw, 4rem);
    }

    .connect-example {
      padding: 0.65rem;
    }

    .connect-request__header,
    .connect-request__section,
    .connect-request__footer {
      padding: 0.9rem;
      grid-template-columns: 1fr;
      gap: 0.8rem;
    }

    .connect-request__status {
      position: absolute;
      margin-top: 0.05rem;
      justify-self: end;
    }

    .connect-request__footer {
      align-items: stretch;
    }

    .connect-request__actions {
      justify-content: flex-end;
    }

    .collection-mode {
      grid-template-columns: 1fr;
      gap: 1.35rem;
    }

    .collection-mode > div {
      display: grid;
      grid-template-columns: minmax(8.5rem, 0.7fr) minmax(0, 1fr);
      gap: 1rem;
    }

    .collection-mode > div p {
      margin-top: 0;
    }

    .connect-control-note,
    .connect-closing__inner {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .connect-closing__inner .button-row {
      margin-top: 0.5rem;
    }
  }

  @media (max-width: 28rem) {
    .collection-mode > div {
      grid-template-columns: 1fr;
      gap: 0.35rem;
    }

    .connect-request__actions {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
    }

    .connect-request__actions span {
      justify-content: center;
    }
  }
</style>
