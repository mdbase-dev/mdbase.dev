---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AppShot from "../../components/AppShot.astro";
import AppIcon from "../../components/AppIcon.astro";
import BuildYourOwn from "../../components/BuildYourOwn.astro";
import "../../styles/apps.css";

type CatalogueEntry = {
  name: string;
  description: string;
  links: Array<{ label: string; href: string }>;
  shot?: { name: "tasknotes" | "editor" | "reader" | "writer"; alt: string };
};

const applications: CatalogueEntry[] = [
  {
    name: "TaskNotes",
    description: "Task manager for the web, iOS and Android, with lists, boards, calendars, recurrence, reminders, attachments, and time tracking.",
    links: [
      { label: "Open TaskNotes", href: "https://app.tasknotes.dev/" },
      { label: "Source", href: "https://github.com/callumalpass/tasknotes-app" }
    ],
    shot: {
      name: "tasknotes",
      alt: "TaskNotes showing today's tasks, with priorities, due dates and projects, and an overdue section."
    }
  },
  {
    name: "mdbase Editor",
    description: "General collection editor for Markdown records, frontmatter, links, backlinks, and type definitions, with collection sharing and read-only access for viewers.",
    links: [
      { label: "Open Editor", href: "https://editor.mdbase.dev/" },
      { label: "Documentation", href: "/apps/editor/" },
      { label: "Source", href: "https://github.com/mdbase-dev/mdbase-connect/tree/main/apps/editor" }
    ],
    shot: {
      name: "editor",
      alt: "mdbase Editor showing a collection's folders and notes beside an open note with a diagram."
    }
  },
  {
    name: "mdbase Reader",
    description: "Read, highlight and organise PDFs, EPUBs and saved web pages, with Markdown notes and citation metadata.",
    links: [
      { label: "Open Reader", href: "https://reader.mdbase.dev/" },
      { label: "Documentation", href: "/apps/reader/" },
      { label: "Chrome extension", href: "https://chromewebstore.google.com/detail/mdbase-reader/kimdfjefhbfgfecconmaiaaindjccidp" }
    ],
    shot: {
      name: "reader",
      alt: "mdbase Reader showing a chapter of The Principles of Psychology with two highlighted passages."
    }
  },
  {
    name: "mdbase writer",
    description: "Write Markdown papers, theses and books with a typeset preview, citations from Reader, and PDF or Word export.",
    links: [
      { label: "Open writer", href: "https://writer.mdbase.dev/" },
      { label: "Documentation", href: "/apps/writer/" }
    ],
    shot: {
      name: "writer",
      alt: "mdbase writer showing a paper's Markdown source, with citations, beside its typeset article preview."
    }
  },
  {
    name: "mdbase Journal",
    description: "A quiet page for writing and revisiting a journal, with each entry saved as a Markdown note in your collection.",
    links: [
      { label: "Open Journal", href: "https://journal.mdbase.dev/" },
      { label: "Source", href: "https://github.com/mdbase-dev/mdbase-journal" }
    ]
  },
  {
    name: "mdbase for Obsidian",
    description: "Obsidian plugin for collection setup, type editing, migration, and validation.",
    links: [{ label: "Source", href: "https://github.com/callumalpass/mdbase-obsidian" }]
  },
  {
    name: "mdbase MCP",
    description: "Remote MCP endpoint for reading and changing approved collections from compatible AI clients.",
    links: [
      { label: "Set up", href: "/apps/mcp/" },
      { label: "Tool reference", href: "/apps/mcp/tools/" }
    ]
  }
];
---

<BaseLayout
  title="Applications"
  description="Applications and collection tools that work with mdbase collections."
  current="apps"
>
  <header class="page-intro">
    <h1>Applications</h1>
    <p class="page-intro__lede">
      Applications are the tools you use to view and change a collection. Each
      one asks for access to a collection and works on the same Markdown
      records.
    </p>
  </header>

  <section class="catalogue-section" aria-label="Current applications and tools">
    <div class="app-list">
      {
        applications.filter((app) => app.shot).map((app) => (
          <article class="app-entry app-entry--shot split">
            <div class="split__text">
              <h2><AppIcon name={app.name} />{app.name}</h2>
              <p>{app.description}</p>
              <div class="app-entry__links">
                {app.links.map((link, index) => <a class={index === 0 ? "button" : undefined} href={link.href}>{link.label}</a>)}
              </div>
            </div>
            {app.shot && <AppShot name={app.shot.name} alt={app.shot.alt} />}
          </article>
        ))
      }
    </div>
    <div class="app-grid">
      {
        applications.filter((app) => !app.shot).map((app) => (
          <article class="app-entry app-entry--card">
            <h2><AppIcon name={app.name} />{app.name}</h2>
            <p>{app.description}</p>
            <div class="app-entry__links">
              {app.links.map((link) => <a href={link.href}>{link.label}</a>)}
            </div>
          </article>
        ))
      }
    </div>
    <article class="app-entry app-entry--shot app-entry--build split">
      <div class="split__text">
        <h2><AppIcon name="Build your own" glyph="plus" />Build your own</h2>
        <p>
          Any app can work with an mdbase collection. The TypeScript SDK asks
          for access, reads and changes records, and follows changes as they
          happen, so the same records can be a list, a board, a calendar or
          whatever your app needs them to be.
        </p>
        <div class="app-entry__links">
          <a class="button" href="/sdk/connect-quickstart/">Build an app</a>
          <a href="/sdk/">SDK overview</a>
        </div>
      </div>
      <BuildYourOwn />
    </article>
  </section>
</BaseLayout>
