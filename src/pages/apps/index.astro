---
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/apps.css";

type CatalogueEntry = {
  name: string;
  description: string;
  status: "Public beta" | "Development build";
  runsOn: string;
  collections: string;
  links: Array<{ label: string; href: string }>;
};

const applications: CatalogueEntry[] = [
  {
    name: "TaskNotes",
    description: "Task manager with lists, boards, calendars, recurrence, reminders, attachments, and time tracking.",
    status: "Public beta",
    runsOn: "Web, iOS, Android",
    collections: "Cloud copy, or Private through one of your devices",
    links: [
      { label: "Open TaskNotes", href: "https://app.tasknotes.dev/" },
      { label: "Try the demo", href: "https://app.tasknotes.dev/?demo=30" },
      { label: "Source", href: "https://github.com/callumalpass/tasknotes-app" }
    ]
  },
  {
    name: "mdbase Editor",
    description: "General collection editor for Markdown records, frontmatter, links, backlinks, and type definitions, with collection sharing and read-only access for viewers.",
    status: "Public beta",
    runsOn: "Web",
    collections: "Cloud copy, or Private through one of your devices",
    links: [
      { label: "Open Editor", href: "https://editor.mdbase.dev/" },
      { label: "Documentation", href: "/apps/editor/" },
      { label: "Source", href: "https://github.com/mdbase-dev/mdbase-connect/tree/main/apps/editor" }
    ]
  },
  {
    name: "mdbase Reader",
    description: "Read, highlight and organise PDFs, EPUBs and saved web pages, with Markdown notes and citation metadata.",
    status: "Development build",
    runsOn: "Web; optional Chrome extension",
    collections: "Cloud copy, or Private through one of your devices",
    links: [
      { label: "Open Reader", href: "https://reader.mdbase.dev/" },
      { label: "Documentation", href: "/apps/reader/" },
      { label: "Try the preview", href: "https://reader.mdbase.dev/?preview=1" },
      { label: "Chrome extension", href: "https://chromewebstore.google.com/detail/mdbase-reader/kimdfjefhbfgfecconmaiaaindjccidp" }
    ]
  },
  {
    name: "mdbase writer",
    description: "Write Markdown papers, theses and books with a typeset preview, citations from Reader, and PDF or Word export.",
    status: "Development build",
    runsOn: "Web",
    collections: "Cloud copy, or Private through one of your devices",
    links: [
      { label: "Open writer", href: "https://writer.mdbase.dev/" },
      { label: "Documentation", href: "/apps/writer/" },
      { label: "Try the demo", href: "https://lab.mdbase-writer.pages.dev/?demo" }
    ]
  },
  {
    name: "mdbase for Obsidian",
    description: "Obsidian plugin for collection setup, type editing, migration, and validation.",
    status: "Development build",
    runsOn: "Obsidian desktop and mobile",
    collections: "Your Obsidian vault",
    links: [{ label: "Source", href: "https://github.com/callumalpass/mdbase-obsidian" }]
  },
  {
    name: "mdbase MCP",
    description: "Remote MCP endpoint for reading and changing approved collections from compatible AI clients.",
    status: "Public beta",
    runsOn: "OAuth-capable MCP clients",
    collections: "Cloud copy, or Private through one of your devices",
    links: [
      { label: "Set up", href: "/apps/mcp/" },
      { label: "Tool reference", href: "/apps/mcp/tools/" }
    ]
  }
];
---

<BaseLayout
  title="Applications"
  description="Applications and collection tools that work with mdbase collections."
  current="apps"
>
  <header class="page-intro">
    <h1>Applications</h1>
    <p class="page-intro__lede">
      Applications are the tools you use to view and change a collection. Each
      one asks for access to a collection and works on the same Markdown
      records.
    </p>
  </header>

  <section class="content-section" aria-labelledby="reaching-collections">
    <h2 id="reaching-collections">How apps reach a collection</h2>
    <p>
      Web apps can use a Cloud copy collection at any time. They reach a Private
      collection through one of your devices, so one of them must be online,
      such as a computer running the <a href="/downloads/">desktop app</a>.
      Several apps can use one collection at once, each within the permission
      you gave it. <a href="/connect/#apps">How permissions work</a>.
    </p>
  </section>

  <section class="catalogue-section" aria-label="Current applications and tools">
    <div class="app-list">
      {
        applications.map((app) => (
          <article class="app-entry">
            <h2>{app.name}</h2>
            <div class="app-entry__description">
              <p>{app.description}</p>
              <div class="app-entry__links">
                {app.links.map((link) => <a href={link.href}>{link.label}</a>)}
              </div>
            </div>
            <dl class="app-meta">
              <div><dt>Status</dt><dd>{app.status}</dd></div>
              <div><dt>Runs on</dt><dd>{app.runsOn}</dd></div>
              <div><dt>Collections</dt><dd>{app.collections}</dd></div>
            </dl>
          </article>
        ))
      }
    </div>
  </section>

  <section class="build-section" aria-label="For application developers">
    <div class="build-section__body">
      <p>
        Any app can work with an mdbase collection. The SDK asks for access,
        reads and changes records, and follows changes. An app’s manifest
        declares the contracts and operations it needs.
      </p>
      <div class="button-row">
        <a href="/sdk/quickstart/">SDK quickstart</a>
        <a href="/sdk/">SDK overview</a>
      </div>
    </div>
  </section>
</BaseLayout>
