---
import BaseLayout from "../../layouts/BaseLayout.astro";
import release from "../../data/connect-release.json";

const { version, tag, releaseUrl: releasePage } = release;
const releaseBase = `https://github.com/mdbase-dev/mdbase-connect/releases/download/${tag}`;
const desktopDownloads = release.desktop;
const cliDownloads = release.cli;
const macDownloadsSigned = desktopDownloads
  .filter(({ platform }) => platform === "macOS")
  .every(({ trust }) => trust === "Signed and notarized" || trust === "Beta preview · notarized");
const published = new Date(release.publishedAt);
const releaseSize = (bytes: number) => `${Math.round(bytes / 1_000_000)} MB`;
---

<BaseLayout
  title="Download"
  description="Download the mdbase Connect desktop app or the standalone command-line tools for macOS, Windows, and Linux."
  current="downloads"
>
  <header class="page-intro">
    <h1>Download</h1>
    <p class="page-intro__lede">
      Install the mdbase Connect desktop app to keep synced collections as
      folders on your computer and let approved apps reach Private collections
      through it.
    </p>
  </header>

  <section class="content-section" aria-labelledby="about-heading">
    <h2 id="about-heading">What the desktop app does</h2>
    <p>
      The desktop app runs the mdbase background service. It keeps a complete
      copy of each collection you sync with this computer as ordinary files,
      syncs your changes, and serves approved apps when a collection is Private.
      It includes the <code>mdbase</code> command-line tool.
    </p>
    <p>
      You don’t need it to use a Cloud copy collection in web apps. These
      builds are beta releases, and syncing requires a{" "}
      <a href="/beta/">Connect account</a>.
    </p>
    <div class="download-summary" aria-label="Release details">
      <span>Version <strong>{version}</strong></span>
      <span>Published <strong><time datetime={release.publishedAt}>{published.toLocaleDateString("en-AU", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" })}</time></strong></span>
    </div>
  </section>

  <section class="content-section" aria-labelledby="desktop-heading">
    <h2 id="desktop-heading">Desktop app</h2>
    <p>
      Choose the package for your computer, then sign in to your Connect
      account from the app.
    </p>

    <div class="callout">
      <strong>Signing and notarization</strong>
      <p>
        Windows may show an Unknown Publisher or SmartScreen warning. {!macDownloadsSigned &&
          "macOS requires a manual Privacy & Security override and the app has not been notarized."} The release includes checksums and Sigstore provenance.
      </p>
    </div>

    <div class="download-list">
      {
        desktopDownloads.map((download) => (
          <article class="download-option">
            <h3>{download.platform}</h3>
            <div class="download-option__detail">
              <p>{download.detail}</p>
              <code>{download.trust} · {releaseSize(download.size)}</code>
            </div>
            <div class="download-option__actions">
              <a class="button button--primary" href={`${releaseBase}/${download.file}`}>
                {download.label}
              </a>
            </div>
          </article>
        ))
      }
    </div>
    <p class="download-note">
      Portable Windows and macOS ZIP builds are available on the{" "}
      <a href={releasePage}>release page</a>.
    </p>
  </section>

  <section id="command-line" class="content-section" aria-labelledby="cli-heading">
    <h2 id="cli-heading">Command line</h2>
    <p>
      The standalone archive contains the <code>mdbase</code> command-line
      tool and background service, for servers and computers with no desktop.
      It has no desktop interface.
    </p>
    <div class="download-list">
      {
        cliDownloads.map((download) => (
          <article class="download-option">
            <h3>{download.platform}</h3>
            <div class="download-option__detail">
              <p>{download.detail}</p>
              <code>{download.trust} · {releaseSize(download.size)}</code>
            </div>
            <div class="download-option__actions">
              <a class="button button--primary" href={`${releaseBase}/${download.file}`}>
                {download.label}
              </a>
            </div>
          </article>
        ))
      }
    </div>
    <p class="download-note">
      Follow the <a href={`https://github.com/mdbase-dev/mdbase-connect/blob/${tag}/docs/headless.md`}>headless installation guide</a>{" "}
      to verify, install, and run the service.
    </p>
  </section>

  <section class="content-section" aria-labelledby="verify-heading">
    <h2 id="verify-heading">Release details</h2>
    <p>
      The GitHub release contains SHA-256 checksums, Sigstore bundles, portable
      packages, release notes, and the complete artifact list.
    </p>
    <div class="button-row download-release-actions">
      <a class="button button--primary" href={releasePage}>Open release {tag}</a>
      <a class="button" href={release.channelManifestUrl}>Signed channel manifest</a>
      <a class="button" href="https://github.com/mdbase-dev/mdbase-connect/releases">All releases</a>
    </div>
  </section>
</BaseLayout>
