---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CodeBlock from "../../components/CodeBlock.astro";

const runCommand = `npm install --save-dev @callumalpass/mdbase-testbed

npx mdbase-testbed validate
npx mdbase-testbed run \\
  --adapter ./scripts/testbed-adapter.mjs \\
  --evidence ./conformance/testbed-evidence.json`;

const protocol = `your-adapter describe
# writes one adapter-description JSON document

your-adapter run
# reads one scenario request from stdin
# writes one observable transcript to stdout`;

const rings = [
  {
    id: "contract",
    number: "01",
    title: "Contract",
    count: 1,
    summary: "One contract, one implementing type, one record, two consumers.",
    scenarios: [
      ["core.shared-contract-consumers", "Both consumers receive the same validated contract view."]
    ]
  },
  {
    id: "interop",
    number: "02",
    title: "Interop",
    count: 11,
    summary: "Live sources, consumers, callers, and providers cross an authorization boundary.",
    scenarios: [
      ["interop.event-multicast", "One event reaches every compatible consumer."],
      ["interop.action-single-provider", "One eligible provider is selected."],
      ["interop.action-ambiguous", "Two eligible providers stop implicit dispatch."],
      ["interop.action-explicit-provider", "An explicit selector resolves ambiguity."],
      ["interop.provider-disappearance", "An unloaded provider is unavailable."],
      ["interop.contract-digest-drift", "Same version with a different digest is rejected."],
      ["interop.invalid-payload", "Schema-invalid data never reaches a handler."],
      ["interop.authority-boundary", "Compatibility cannot grant authority."],
      ["interop.request-replay", "A logical request is not applied twice."],
      ["interop.application-provider-lifecycle", "A real app provider registers, validates, runs, and unloads."],
      ["interop.application-event-multicast", "A real app source reaches two independent consumers."]
    ]
  },
  {
    id: "runtime",
    number: "03",
    title: "Runtime",
    count: 3,
    summary: "Durable admission, recovery, and worker fencing are observed through the store.",
    scenarios: [
      ["runtime.crash-recovery", "A lost outcome reuses the same attempt and invocation."],
      ["runtime.competing-workers", "A stale worker cannot commit after its lease expires."],
      ["runtime.application-execution", "A real app catalog produces one exact successful run."]
    ]
  }
];
---

<BaseLayout
  title="Interoperability testbed"
  description="Run the same portable black-box scenarios against every mdbase contract, interoperability, and durable runtime implementation."
  current="testbed"
>
  <section class="page-hero testbed-hero">
    <div class="page-hero__inner">
      <div>
        <p class="eyebrow"><i></i> Portable testbed 0.1</p>
        <h1>Make the same promise. Prove the same behavior.</h1>
      </div>
      <div class="page-hero__aside">
        <p>
          One neutral suite tests TypeScript, Rust, plugins, desktop services,
          and future implementations through a process boundary. Products keep
          their own architecture; users get comparable evidence.
        </p>
        <div class="button-row">
          <a class="button button--primary" href="#run-it">Run the testbed</a>
          <a class="button" href="/testbed/v0.1/scenarios/core.shared-contract-consumers.json">
            Open a scenario
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="trace-section" aria-labelledby="trace-title">
    <div class="trace-heading">
      <div>
        <p class="eyebrow">The black-box boundary</p>
        <h2 id="trace-title">The spec asks. Your implementation answers.</h2>
      </div>
      <p>
        Each scenario starts a fresh adapter process. Only stable facts cross
        the boundary; generated IDs, database keys, and wall-clock timing stay
        inside.
      </p>
    </div>
    <div class="trace-board" role="img" aria-label="Contract, interop, and runtime scenarios pass through a process adapter and produce canonical transcripts">
      <div class="trace-board__header">
        <span>Neutral scenario</span>
        <span>Process adapter</span>
        <span>Canonical transcript</span>
      </div>
      {
        rings.map((ring) => (
          <div class="trace-row">
            <div class="trace-ring">
              <span>{ring.number}</span>
              <strong>{ring.title}</strong>
            </div>
            <div class="trace-wire" aria-hidden="true"><i></i><b>run</b><i></i></div>
            <div class="trace-adapter">
              <code>describe</code>
              <code>run</code>
            </div>
            <div class="trace-wire" aria-hidden="true"><i></i><b>JSON</b><i></i></div>
            <div class="trace-pass"><span>PASS</span><strong>{String(ring.count).padStart(2, "0")}</strong></div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="content-section">
    <h2>What the testbed separates</h2>
    <div class="testbed-principles">
      <article>
        <span>Owned by the specification</span>
        <h3>The question and the oracle</h3>
        <p>
          Draft 2020-12 schemas define neutral fixtures, run requests, adapter
          descriptions, transcripts, and evidence. Every expected transcript
          lives beside its scenario.
        </p>
      </article>
      <article>
        <span>Owned by the implementation</span>
        <h3>The behavior under test</h3>
        <p>
          An adapter drives public collection, bridge, provider, runtime, and
          store boundaries. It reduces observations to stable facts; it does
          not reimplement the feature.
        </p>
      </article>
      <article>
        <span>Owned by neither</span>
        <h3>Authority</h3>
        <p>
          Passing proves behavior, not permission. A transcript cannot grant
          access, register a provider, publish an event, or authorize a side
          effect.
        </p>
      </article>
    </div>
  </section>

  <section class="content-section scenario-section">
    <div class="section-intro">
      <div>
        <p class="eyebrow">15 scenarios · 3 rings</p>
        <h2>The portable inventory</h2>
      </div>
      <p>
        Small scenarios isolate failures. Application scenarios then repeat
        the critical paths with real product contracts and providers.
      </p>
    </div>
    <div class="ring-inventory">
      {
        rings.map((ring) => (
          <article id={`ring-${ring.id}`} class="ring-card">
            <header>
              <span>{ring.number}</span>
              <div>
                <h3>{ring.title}</h3>
                <p>{ring.summary}</p>
              </div>
              <strong>{ring.count}</strong>
            </header>
            <ul>
              {
                ring.scenarios.map(([id, description]) => (
                  <li>
                    <a href={`/testbed/v0.1/scenarios/${id}.json`}><code>{id}</code></a>
                    <span>{description}</span>
                  </li>
                ))
              }
            </ul>
          </article>
        ))
      }
    </div>
  </section>

  <section id="run-it" class="content-section run-section">
    <div class="section-intro">
      <div>
        <p class="eyebrow">Fresh process per scenario</p>
        <h2>Run it from any language</h2>
      </div>
      <p>
        The runner launches an executable directly—never through a shell—and
        validates both sides of every exchange before comparing observations.
      </p>
    </div>
    <div class="run-grid">
      <div>
        <h3>Install and verify</h3>
        <CodeBlock code={runCommand} language="sh" label="terminal" />
      </div>
      <div>
        <h3>Implement two commands</h3>
        <CodeBlock code={protocol} language="text" label="adapter protocol" />
      </div>
    </div>
    <div class="button-row">
      <a class="button button--primary" href="/testbed/v0.1/README.md">
        Read the adapter protocol
      </a>
      <a class="button" href="/testbed/schemas/v0.1/scenario.schema.json">
        Scenario JSON Schema
      </a>
      <a class="button" href="https://github.com/mdbase-dev/mdbase-spec/tree/main/packages/testbed">
        Reference implementation
      </a>
    </div>
  </section>

  <section class="content-section">
    <h2>Evidence is precise—and deliberately limited</h2>
    <p>
      A passing run can emit a machine-readable evidence document containing
      the implementation identity, scenario IDs, profile names, and canonical
      transcript digests. Attach it to a conformance claim to make the tested
      behavior reproducible.
    </p>
    <div class="callout callout--success">
      <strong>Supplemental evidence, not a blanket badge</strong>
      <p>
        A complete profile claim still runs every normative conformance test
        for that profile. The testbed adds cross-language behavioral evidence;
        it does not silently widen the claim.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .testbed-hero h1 {
    max-width: 14ch;
  }

  .trace-section {
    width: min(100% - 2rem, var(--page));
    margin-inline: auto;
    padding-block: clamp(3.5rem, 6vw, 5.5rem);
    border-bottom: 1px solid var(--line);
  }

  .trace-heading,
  .section-intro {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(18rem, 0.7fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: end;
  }

  .trace-heading h2,
  .section-intro h2 {
    margin-top: 0.65rem;
  }

  .trace-heading > p,
  .section-intro > p {
    color: var(--ink-soft);
    font-size: 0.9rem;
  }

  .trace-board {
    margin-top: 2.5rem;
    padding: 0.9rem;
    background:
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px),
      var(--surface);
    background-size: 1.5rem 1.5rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
  }

  .trace-board__header,
  .trace-row {
    display: grid;
    grid-template-columns: minmax(8rem, 1fr) minmax(3rem, 0.48fr) minmax(8rem, 0.8fr) minmax(3rem, 0.48fr) minmax(5rem, 0.55fr);
    align-items: center;
  }

  .trace-board__header {
    padding: 0.2rem 0.7rem 0.65rem;
    color: var(--ink-muted);
    font: 500 0.58rem/1.3 var(--mono);
  }

  .trace-board__header span:nth-child(2) {
    grid-column: 3;
  }

  .trace-board__header span:nth-child(3) {
    grid-column: 5;
    text-align: right;
  }

  .trace-row {
    min-height: 5.25rem;
    padding: 0.7rem;
    background: color-mix(in oklch, var(--canvas) 94%, transparent);
    border: 1px solid var(--line);
  }

  .trace-row + .trace-row {
    margin-top: 0.5rem;
  }

  .trace-ring,
  .trace-pass {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .trace-ring span,
  .ring-card header > span {
    color: var(--ink-muted);
    font: 500 0.6rem/1 var(--mono);
  }

  .trace-ring strong {
    font-size: 0.9rem;
  }

  .trace-wire {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 0.35rem;
  }

  .trace-wire i {
    height: 1px;
    background: var(--line-strong);
  }

  .trace-wire b {
    color: var(--ink-muted);
    font: 500 0.52rem/1 var(--mono);
  }

  .trace-adapter {
    display: flex;
    padding: 0.55rem 0.65rem;
    justify-content: space-between;
    gap: 0.5rem;
    background: var(--canvas);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
  }

  .trace-adapter code {
    color: var(--ink-soft);
    font-size: 0.65rem;
  }

  .trace-pass {
    justify-content: flex-end;
  }

  .trace-pass span {
    padding: 0.28rem 0.42rem;
    color: var(--ink);
    background: color-mix(in oklch, var(--surface) 78%, var(--signal));
    border: 1px solid color-mix(in oklch, var(--line) 55%, var(--signal));
    border-radius: 2px;
    font: 500 0.56rem/1 var(--mono);
  }

  .trace-pass strong {
    min-width: 1.8rem;
    color: var(--ink-muted);
    font: 500 0.72rem/1 var(--mono);
    text-align: right;
  }

  .testbed-principles {
    display: grid;
    margin-top: 2.5rem;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--line-strong);
  }

  .testbed-principles article {
    padding: 1.25rem 1.25rem 0 0;
  }

  .testbed-principles article + article {
    padding-left: 1.25rem;
    border-left: 1px solid var(--line);
  }

  .testbed-principles span {
    color: var(--ink-muted);
    font: 500 0.58rem/1.3 var(--mono);
  }

  .testbed-principles h3 {
    margin-top: 0.55rem;
  }

  .testbed-principles p {
    margin-top: 0.65rem;
    color: var(--ink-soft);
    font-size: 0.84rem;
  }

  .ring-inventory {
    margin-top: 2.5rem;
    border-top: 1px solid var(--line-strong);
  }

  .ring-card {
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--line);
  }

  .ring-card header {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr) auto;
    gap: 1rem;
  }

  .ring-card header p {
    max-width: 60ch;
    margin-top: 0.3rem;
    color: var(--ink-soft);
    font-size: 0.82rem;
  }

  .ring-card header > strong {
    color: var(--ink-muted);
    font: 500 1.4rem/1 var(--mono);
  }

  .ring-card ul {
    display: grid;
    padding: 0;
    margin: 1.1rem 0 0 3.5rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 2rem;
    list-style: none;
  }

  .ring-card li {
    display: grid;
    max-width: none;
    padding-block: 0.65rem;
    grid-template-columns: minmax(14rem, 0.7fr) minmax(0, 1fr);
    gap: 1rem;
    border-top: 1px solid var(--line);
  }

  .ring-card li a {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .ring-card li code {
    font-size: 0.67rem;
  }

  .ring-card li span {
    color: var(--ink-soft);
    font-size: 0.76rem;
  }

  .run-grid {
    display: grid;
    margin-top: 2rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .run-grid h3 {
    font-size: 0.88rem;
  }

  .run-grid .code-block {
    height: calc(100% - 1.7rem);
  }

  .run-section > .button-row {
    margin-top: 1.25rem;
  }

  @media (max-width: 60rem) {
    .trace-heading,
    .section-intro,
    .testbed-principles,
    .run-grid {
      grid-template-columns: 1fr;
    }

    .testbed-principles article + article {
      padding-left: 0;
      border-top: 1px solid var(--line);
      border-left: 0;
    }

    .trace-board__header {
      display: none;
    }

    .trace-row {
      grid-template-columns: minmax(6.5rem, 1fr) 2rem minmax(7rem, 1fr) 2rem minmax(4rem, 0.7fr);
    }

    .trace-wire b {
      display: none;
    }

    .ring-card ul {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 40rem) {
    .trace-board {
      padding: 0.5rem;
    }

    .trace-row {
      grid-template-columns: 1fr auto;
      gap: 0.75rem;
    }

    .trace-wire,
    .trace-adapter {
      display: none;
    }

    .trace-pass {
      grid-column: 2;
    }

    .ring-card header {
      grid-template-columns: 2rem minmax(0, 1fr) auto;
    }

    .ring-card ul {
      margin-left: 3rem;
    }

    .ring-card li {
      grid-template-columns: 1fr;
      gap: 0.3rem;
    }
  }
</style>
