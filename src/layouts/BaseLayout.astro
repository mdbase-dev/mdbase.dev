---
import "@fontsource/ibm-plex-sans/400.css";
import "@fontsource/ibm-plex-sans/400-italic.css";
import "@fontsource/ibm-plex-sans/500.css";
import "@fontsource/ibm-plex-sans/600.css";
import "@fontsource/azeret-mono/400.css";
import "@fontsource/azeret-mono/500.css";
import "../styles/shell.css";
import "../styles/global.css";
import "../styles/app-shot.css";
import FontPreloads from "../components/FontPreloads.astro";
import MediaViewer from "../components/MediaViewer.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import ThemeControlScript from "../components/ThemeControlScript.astro";

interface Props {
  title: string;
  description: string;
  current?: "home" | "apps" | "downloads" | "connect" | "pricing" | "sdk" | "runtime" | "spec";
  noIndex?: boolean;
  /** Whether the page gets a Markdown copy and a place in llms.txt; off for an archived copy of current content. */
  markdownCopy?: boolean;
  wide?: boolean;
  /** List the page's sections beside the text on wide screens, for long pages of prose. */
  contents?: boolean;
}

const { title, description, current, noIndex = false, markdownCopy = true, wide = false, contents = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const fullTitle = title === "mdbase" ? title : `${title} | mdbase`;

// The section list is built from the page's own h2s, so a page opts in with one
// prop. Headings without an id are given one from their text.
let body = "";
const sections: { id: string; label: string }[] = [];
if (contents) {
  const seen = new Set<string>();
  const text = (html: string) =>
    html.replace(/<[^>]+>/g, "").replace(/&amp;/g, "&").replace(/\s+/g, " ").trim();
  body = (await Astro.slots.render("default")).replace(
    /<h2\b([^>]*)>([\s\S]*?)<\/h2>/g,
    (heading: string, attributes: string, inner: string) => {
      const label = text(inner);
      let id = attributes.match(/\bid="([^"]+)"/)?.[1];
      if (id) {
        seen.add(id);
        sections.push({ id, label });
        return heading;
      }
      const base = label.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "") || "section";
      id = base;
      for (let n = 2; seen.has(id); n += 1) id = `${base}-${n}`;
      seen.add(id);
      sections.push({ id, label });
      return `<h2 id="${id}"${attributes}>${inner}</h2>`;
    }
  );
}
const showContents = sections.length > 2;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {markdownCopy && !noIndex && <link rel="alternate" type="text/markdown" href="index.md" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/site.webmanifest" />
    <FontPreloads />
    <link rel="stylesheet" href="/mdbase-theme.css" />
    <meta name="theme-color" content="#f6fafd" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="mdbase" />
    <meta property="og:image" content={new URL("/og-card.jpg", Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="The mdbase mark beside the words: mdbase, Structured data in ordinary Markdown files" />
    <meta name="twitter:card" content="summary_large_image" />
    {noIndex && <meta name="robots" content="noindex" />}
    <script is:inline src="/theme-bootstrap.js"></script>
  </head>
  <body class:list={["site-body", { "site-body--wide": wide, "site-body--contents": showContents }]}>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader current={current} />
    <main id="main" tabindex="-1" data-markdown-body={markdownCopy && !noIndex ? "" : undefined}>
      {
        showContents && (
          <aside class="page-contents" data-markdown-ignore>
            <strong>On this page</strong>
            <nav aria-label="On this page">
              {sections.map((section) => <a href={`#${section.id}`}>{section.label}</a>)}
            </nav>
          </aside>
        )
      }
      {contents ? <Fragment set:html={body} /> : <slot />}
    </main>
    <SiteFooter />
    <MediaViewer />
    <ThemeControlScript />
    <p class="sr-only" id="copy-status" role="status" aria-live="polite"></p>
    <script is:inline>
      document.querySelectorAll("[data-copy-code]").forEach((button) => {
        button.addEventListener("click", async () => {
          const wrapper = button.closest(".code-block");
          const code = wrapper?.querySelector("code")?.textContent ?? "";
          const previous = button.textContent;
          const status = document.querySelector("#copy-status");
          try {
            await navigator.clipboard.writeText(code);
            button.textContent = "Copied";
            if (status) status.textContent = "Code copied to the clipboard.";
          } catch {
            button.textContent = "Copy failed";
            if (status) {
              status.textContent =
                "Code could not be copied. Select the code and copy it manually.";
            }
          }
          window.setTimeout(() => {
            button.textContent = previous;
          }, 1800);
        });
      });
    </script>
  </body>
</html>
