<script is:inline>
  (() => {
    const root = document.documentElement;
    const media = matchMedia("(prefers-color-scheme: dark)");
    const controls = document.querySelectorAll(".theme-toggle");

    const savedTheme = () => {
      try {
        const saved = localStorage.getItem("mdbase:theme");
        return saved === "light" || saved === "dark" ? saved : null;
      } catch {
        return null;
      }
    };

    const currentTheme = () =>
      root.dataset.theme || (media.matches ? "dark" : "light");

    const updateControls = () => {
      controls.forEach((control) => {
        const next = currentTheme() === "dark" ? "Light" : "Dark";
        control.textContent = next;
        control.setAttribute("aria-label", `Use ${next.toLowerCase()} mode`);
        control.hidden = false;
      });
    };

    const apply = (theme, persist = false) => {
      if (theme) root.dataset.theme = theme;
      else delete root.dataset.theme;
      if (persist) {
        try {
          localStorage.setItem("mdbase:theme", theme);
        } catch {
          // The choice still applies for this page.
        }
      }
      const dark = currentTheme() === "dark";
      document
        .querySelector('meta[name="theme-color"]')
        ?.setAttribute("content", dark ? "#121212" : "#faf9f6");
      updateControls();
      dispatchEvent(new CustomEvent("mdbase:themechange"));
    };

    apply(savedTheme());
    controls.forEach((control) => {
      control.addEventListener("click", () => {
        apply(currentTheme() === "dark" ? "light" : "dark", true);
      });
    });
    media.addEventListener("change", () => {
      if (!savedTheme()) apply(null);
    });
  })();
</script>
