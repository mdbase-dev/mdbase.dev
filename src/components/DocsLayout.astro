---
import BaseLayout from "../layouts/BaseLayout.astro";

interface Props {
  title: string;
  description: string;
  active: string;
  headings?: Array<{ href: string; label: string }>;
}

const { title, description, active, headings = [] } = Astro.props;
const docGroups = [
  {
    label: "Start",
    docs: [
      { href: "/sdk/quickstart/", label: "Run the source-built sandbox", key: "quickstart" },
      { href: "/sdk/connect-quickstart/", label: "Connect a browser app", key: "connect-quickstart" },
      { href: "/sdk/", label: "SDK overview", key: "overview" }
    ]
  },
  {
    label: "Build",
    docs: [
      { href: "/sdk/portable-apps/", label: "Portable HTML apps", key: "portable-apps" },
      { href: "/sdk/manifest/", label: "Application manifest", key: "manifest" },
      { href: "/sdk/contracts/", label: "Contracts and adapters", key: "contracts" },
      { href: "/sdk/authorization/", label: "Authorization", key: "authorization" },
      { href: "/sdk/operations/", label: "Records and operations", key: "operations" },
      { href: "/sdk/routing/", label: "Authority routes", key: "routing" },
      { href: "/sdk/testing/", label: "Testing", key: "testing" },
      { href: "/sdk/notifications/", label: "Notifications and timers", key: "notifications" },
      { href: "/sdk/offline-sync/", label: "Offline sync", key: "offline-sync" }
    ]
  },
  {
    label: "Reference",
    docs: [
      { href: "/sdk/security/", label: "Security model", key: "security" },
      { href: "/sdk/api/", label: "API reference", key: "api" }
    ]
  }
];
---

<BaseLayout title={title} description={description} current="sdk">
  <div class="docs-shell">
    <aside class="docs-nav">
      <details open data-docs-nav>
        <summary>Connect SDK</summary>
        <nav aria-label="SDK documentation">
          {
            docGroups.map((group) => (
              <div class="docs-nav__group">
                <strong>{group.label}</strong>
                {
                  group.docs.map((doc) => (
                    <a href={doc.href} aria-current={active === doc.key ? "page" : undefined}>
                      {doc.label}
                    </a>
                  ))
                }
              </div>
            ))
          }
        </nav>
      </details>
      <div class="docs-nav__meta">
        <span>@mdbase/connect</span>
        <strong>0.1.0-beta.12</strong>
      </div>
    </aside>
    <article class="docs-article">
      <header class="docs-title">
        <p>Connect SDK</p>
        <h1>{title}</h1>
        <span>{description}</span>
      </header>
      <slot />
      <footer class="docs-edit">
        <a href="https://github.com/mdbase-dev/mdbase.dev/tree/main/src/pages/sdk">
          Edit this page on GitHub
        </a>
      </footer>
    </article>
    {
      headings.length > 0 && (
        <aside class="docs-toc">
          <strong>On this page</strong>
          <nav aria-label="On this page">
            {headings.map((heading) => <a href={heading.href}>{heading.label}</a>)}
          </nav>
        </aside>
      )
    }
  </div>
  <script is:inline>
    const docsNavigation = document.querySelector("[data-docs-nav]");
    if (
      docsNavigation instanceof HTMLDetailsElement
      && window.matchMedia("(max-width: 60rem)").matches
    ) {
      docsNavigation.open = false;
    }
  </script>
</BaseLayout>
