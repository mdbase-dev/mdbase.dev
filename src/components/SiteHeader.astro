---
interface Props {
  current?: "home" | "apps" | "downloads" | "connect" | "sdk" | "runtime" | "spec";
}

const { current } = Astro.props;
const links = [
  { href: "/", label: "Home", key: "home" },
  { href: "/apps/", label: "Apps", key: "apps" },
  { href: "/connect/", label: "Connect", key: "connect" },
  { href: "/sdk/", label: "Documentation/SDK", key: "sdk" },
  { href: "/runtime/", label: "Runtime", key: "runtime" }
] as const;
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="wordmark" href="/" aria-label="mdbase home">mdbase</a>
    <nav class="site-nav" aria-label="Primary navigation">
      {
        links.map((link) => (
          <a href={link.href} aria-current={current === link.key ? "page" : undefined}>
            {link.label}
          </a>
        ))
      }
      <button class="theme-toggle" type="button" hidden>Dark</button>
    </nav>
  </div>
</header>
