---
interface Props {
  current?: "home" | "apps" | "downloads" | "connect" | "sdk" | "runtime" | "spec";
}

const { current } = Astro.props;
const links = [
  { href: "/", label: "Home", key: "home" },
  { href: "/connect/", label: "Connect", key: "connect" },
  { href: "/downloads/", label: "Downloads", key: "downloads" },
  { href: "/apps/", label: "Apps", key: "apps" }
] as const;
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="wordmark" href="/" aria-label="mdbase home">mdbase</a>
    <nav class="site-nav" aria-label="Primary navigation">
      {
        links.map((link) => (
          <a href={link.href} aria-current={current === link.key ? "page" : undefined}>
            {link.label}
          </a>
        ))
      }
      <button class="theme-toggle" type="button" aria-label="Use dark mode" title="Use dark mode" hidden>
        <svg class="theme-toggle__icon" viewBox="0 0 16 16" aria-hidden="true">
          <circle cx="8" cy="8" r="5.5"></circle>
          <path d="M8 2.5a5.5 5.5 0 0 0 0 11Z"></path>
        </svg>
      </button>
    </nav>
  </div>
</header>
