---
// Renders a declaration comment: paragraphs, with `backticked` names as code.
// `inline` renders the text as one run, for use inside another paragraph.
interface Props {
  text: string;
  inline?: boolean;
}

const { text, inline = false } = Astro.props;
const paragraphs = (inline ? [text] : text.split(/\n\s*\n/))
  .map((paragraph) => paragraph.replace(/\s+/g, " ").trim())
  .filter(Boolean)
  .map((paragraph) => paragraph.split("`"));
---

{
  paragraphs.map((parts) => {
    const run = parts.map((part, index) => (index % 2 === 1 ? <code>{part}</code> : part));
    return inline ? run : <p>{run}</p>;
  })
}
