---
// A screenshot of a real app in a quiet window frame. Each app is captured in
// light and dark (public/images/apps/<name>-light|dark.webp, 1600×1000 from a
// 1120×700 window at 2×), and the frame shows the capture matching the site's
// theme. The hidden capture is display: none, so the browser never loads it.
// The Connect and desktop captures come from the apps' own review fixtures (a made-up
// account), taken the same way with scripts/screenshots; see docs/app-documentation.md.
interface Props {
  name:
    | "tasknotes" | "editor" | "reader" | "writer"
    | "connect-approve" | "connect-collections" | "connect-sharing"
    | "desktop-home" | "desktop-collections";
  alt: string;
  eager?: boolean;
}

// The window bar shows a web app's address, or the desktop app's name.
const hosts = {
  tasknotes: "app.tasknotes.dev",
  editor: "editor.mdbase.dev",
  reader: "reader.mdbase.dev",
  writer: "writer.mdbase.dev",
  "connect-approve": "connect.mdbase.dev",
  "connect-collections": "connect.mdbase.dev",
  "connect-sharing": "connect.mdbase.dev",
  "desktop-home": "mdbase Connect",
  "desktop-collections": "mdbase Connect"
} as const;

// On a phone a whole window is too small to read, so each capture names the part
// worth showing there: its left and top edges, width and height, as fractions of
// the capture. Opening the screenshot shows all of it.
const crops = {
  tasknotes: [0.2, 0.02, 0.62, 0.62],
  editor: [0.25, 0, 0.62, 0.62],
  reader: [0.2, 0.08, 0.6, 0.6],
  writer: [0, 0, 0.62, 0.62],
  "connect-approve": [0.19, 0.09, 0.62, 0.89],
  "connect-collections": [0.21, 0.02, 0.62, 0.62],
  "connect-sharing": [0.19, 0.52, 0.79, 0.36],
  "desktop-home": [0.22, 0.03, 0.4, 0.5],
  "desktop-collections": [0.22, 0.03, 0.6, 0.5]
} as const;

const { name, alt, eager = false } = Astro.props;
const hasCaption = Astro.slots.has("caption");
const loading = eager ? "eager" : "lazy";
const [cropX, cropY, cropW, cropH] = crops[name];
const crop = `--crop-x: ${cropX}; --crop-y: ${cropY}; --crop-w: ${cropW}; --crop-ratio: ${((1.6 * cropW) / cropH).toFixed(3)};`;
---

<figure class="app-shot">
  <div class="app-shot__window" data-view-image={hosts[name]} tabindex="0" role="button" aria-label={`Enlarge the screenshot: ${alt}`}>
    <div class="app-shot__bar" aria-hidden="true">
      <span>{hosts[name]}</span>
      <svg class="app-shot__enlarge" viewBox="0 0 16 16"><path d="M9.5 2.5h4v4M6.5 13.5h-4v-4M13.5 2.5l-4.5 4.5M2.5 13.5 7 9" /></svg>
    </div>
    <div class="app-shot__crop" style={crop}>
      <img
        class="app-shot__image app-shot__image--light"
        src={`/images/apps/${name}-light.webp`}
        alt={alt}
        width="1600"
        height="1000"
        loading={loading}
        decoding="async"
      />
      <img
        class="app-shot__image app-shot__image--dark"
        src={`/images/apps/${name}-dark.webp`}
        alt={alt}
        width="1600"
        height="1000"
        loading={loading}
        decoding="async"
        data-markdown-ignore
      />
    </div>
  </div>
  {hasCaption && <figcaption><slot name="caption" /></figcaption>}
</figure>

<style is:global>
  .app-shot {
    --app-shot-shadow:
      0 1px 2px oklch(25% 0.02 250 / 0.06),
      0 8px 18px -10px oklch(25% 0.02 250 / 0.18),
      0 28px 56px -28px oklch(25% 0.03 250 / 0.32);
    margin: 0;
  }

  .app-shot__window {
    overflow: hidden;
    background: var(--color-surface, var(--color-canvas));
    border: 1px solid var(--color-border-strong, var(--color-border));
    border-radius: var(--radius-lg, 10px);
    box-shadow: var(--app-shot-shadow);
  }

  .app-shot__window[data-view-image] { cursor: zoom-in; }
  .app-shot__window[data-view-image]:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 3px; }

  .app-shot__bar {
    position: relative;
    display: flex;
    height: 28px;
    align-items: center;
    justify-content: center;
    color: var(--color-text-muted);
    background: var(--color-surface-subtle, var(--color-canvas));
    border-bottom: 1px solid var(--color-border);
    font: 400 0.68rem/1 var(--mono, monospace);
    letter-spacing: 0.01em;
  }

  /* The corner mark says the screenshot opens; it brightens with the window. */
  .app-shot__enlarge {
    position: absolute;
    top: 7px;
    right: 9px;
    width: 13px;
    height: 13px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.3;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0.55;
  }
  .app-shot__window:is(:hover, :focus-visible) .app-shot__enlarge { color: var(--color-text); opacity: 1; }

  .app-shot__image {
    display: block;
    width: 100%;
    height: auto;
  }

  /* On a phone, the named part of the capture fills the frame. */
  @media (max-width: 40rem) {
    .app-shot__crop { position: relative; overflow: hidden; aspect-ratio: var(--crop-ratio); }
    .app-shot__crop .app-shot__image {
      position: absolute;
      top: 0;
      left: 0;
      width: calc(100% / var(--crop-w));
      max-width: none;
      transform: translate(calc(var(--crop-x) * -100%), calc(var(--crop-y) * -100%));
    }
  }

  .app-shot__image--dark { display: none; }

  :root[data-theme="dark"] .app-shot__image--light { display: none; }
  :root[data-theme="dark"] .app-shot__image--dark { display: block; }

  :root[data-theme="dark"] .app-shot {
    --app-shot-shadow:
      0 1px 2px oklch(0% 0 0 / 0.3),
      0 28px 56px -24px oklch(0% 0 0 / 0.6);
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme]) .app-shot__image--light { display: none; }
    :root:not([data-theme]) .app-shot__image--dark { display: block; }
    :root:not([data-theme]) .app-shot {
      --app-shot-shadow:
        0 1px 2px oklch(0% 0 0 / 0.3),
        0 28px 56px -24px oklch(0% 0 0 / 0.6);
    }
  }

  .app-shot figcaption {
    margin-top: 0.75rem;
    color: var(--color-text-soft);
    font-size: 0.85em;
  }
</style>
