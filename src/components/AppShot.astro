---
import { shotWindow, type hosts } from "../markdown/app-shot.mjs";

interface Props {
  name: keyof typeof hosts;
  alt: string;
  eager?: boolean;
}
const { name, alt, eager } = Astro.props;
---
<figure class="app-shot">
  <Fragment set:html={shotWindow(name, alt, eager)} />
  {Astro.slots.has("caption") && <figcaption><slot name="caption" /></figcaption>}
</figure>
