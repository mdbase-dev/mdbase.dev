---
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
// Bars in reading order; `--step` staggers the hover ripple through them.
const bars = [
  { x: 22, y: 22, width: 20 },
  { x: 50, y: 22, width: 20 },
  { x: 78, y: 22, width: 20 },
  { x: 22, y: 44, width: 12 },
  { x: 42, y: 44, width: 56, accent: true },
  { x: 22, y: 66, width: 28 },
  { x: 58, y: 66, width: 40 },
  { x: 22, y: 88, width: 20 },
  { x: 50, y: 88, width: 20 },
  { x: 78, y: 88, width: 20 }
];
---

<svg
  class:list={["brand-mark", { "brand-mark--compact": compact }]}
  viewBox="18 18 84 84"
  aria-hidden="true"
  focusable="false"
>
  {
    bars.map((bar, step) => (
      <rect
        class:list={["brand-mark__bar", { "brand-mark__accent": bar.accent }]}
        style={`--step: ${step}`}
        x={bar.x}
        y={bar.y}
        width={bar.width}
        height="10"
        fill={bar.accent ? "#005c88" : "currentColor"}
      />
    ))
  }
</svg>
