---
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<svg
  class:list={["brand-mark", { "brand-mark--compact": compact }]}
  viewBox="18 18 84 84"
  aria-hidden="true"
  focusable="false"
>
  <g class="brand-mark__ink">
    <rect x="22" y="22" width="20" height="10" rx="2"></rect>
    <rect x="50" y="22" width="20" height="10" rx="2"></rect>
    <rect x="78" y="22" width="20" height="10" rx="2"></rect>
    <rect x="22" y="44" width="12" height="10" rx="2"></rect>
    <rect x="22" y="66" width="28" height="10" rx="2"></rect>
    <rect x="58" y="66" width="40" height="10" rx="2"></rect>
    <rect x="22" y="88" width="20" height="10" rx="2"></rect>
    <rect x="50" y="88" width="20" height="10" rx="2"></rect>
    <rect x="78" y="88" width="20" height="10" rx="2"></rect>
  </g>
  <rect class="brand-mark__accent" x="42" y="44" width="56" height="10" rx="2"></rect>
</svg>

